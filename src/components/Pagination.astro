---
import Default from '@astrojs/starlight/components/Pagination.astro';

const currentPath = Astro.url.pathname;
const versionMatch = currentPath.match(/^\/(?:en|th)\/(v\d+_\d+)\//);
const currentVersion = versionMatch?.[1]?.replace('_', '.');
const { pagination } = Astro.locals.starlightRoute;

function isSameVersion(href: string | undefined): boolean {
  if (!href || !currentVersion) return true;
  return href.includes(`/${currentVersion.replace('.', '_')}/`);
}

if (currentVersion) {
  pagination.prev = isSameVersion(pagination.prev?.href) ? pagination.prev : undefined;
  pagination.next = isSameVersion(pagination.next?.href) ? pagination.next : undefined;
}
---

<Default><slot /></Default>
