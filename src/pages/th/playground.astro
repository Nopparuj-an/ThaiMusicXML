---
// A live editor + renderer preview: type ThaiMusicXML, see the score it draws.
// The renderer itself runs entirely client-side (see renderer/src/#font-loader
// and #dom-parser in package.json's "imports" for the Node/browser split), so
// this page needs no server and works the same offline as it does deployed.
//
// Thai counterpart of ../en/playground.astro - same script and layout,
// translated UI strings, matching how the rest of the site keeps one content
// file per locale rather than a shared translation layer.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage frontmatter={{ title: "สนามทดลอง", tableOfContents: false }}>
  <div class="playground-root not-content">
    <p class="intro">
      แก้ไข ThaiMusicXML ทางด้านซ้าย แล้วดูโน้ตที่แสดงผลทางด้านขวา
      เลือกจุดเริ่มต้นด้านล่าง หรือล้างช่องแก้ไขแล้วเขียนเอง
    </p>

    <div class="toolbar">
      <label for="template-select">แม่แบบ</label>
      <select id="template-select">
        <option value="example-khaek-borathes.txml">ตัวอย่าง: แขกบรเทศ</option>
        <option value="example-sathukan.txml">ตัวอย่าง: สาธุการ</option>
        <option value="example-chuen-chumnum.txml"
          >ตัวอย่าง: ชื่นชุมนุม - กลุ่มดนตรี</option
        >
        <option value="example-chomsurang.txml"
          >ตัวอย่าง: โหมโรงจอมสุรางค์</option
        >
        <option value="tutorial1-hello-world.txml"
          >บทช่วยสอน 1: Hello World</option
        >
        <option value="tutorial2-file-structure.txml"
          >บทช่วยสอน 2: โครงสร้างไฟล์</option
        >
      </select>

      <details class="toolbar-settings">
        <summary>ตั้งค่า</summary>
        <div class="settings-panel">
          <div class="settings-grid" id="settings-common"></div>
          <details>
            <summary>ตัวเลือกเพิ่มเติม</summary>
            <div class="settings-grid" id="settings-details"></div>
          </details>
          <details>
            <summary>ขั้นสูง</summary>
            <div class="settings-grid" id="settings-advanced"></div>
          </details>
          <button type="button" class="settings-reset" id="settings-reset"
            >คืนค่าเริ่มต้น</button
          >
        </div>
      </details>
    </div>

    <div class="split" id="split">
      <div class="pane editor-pane" id="editor-pane"></div>
      <div
        class="divider"
        id="divider"
        role="separator"
        aria-orientation="vertical"
        aria-label="ปรับขนาดช่องแก้ไขและตัวอย่าง"
      >
      </div>
      <div class="pane preview-pane" id="preview-pane"></div>
    </div>

    <p class="status" id="status" role="status"></p>
  </div>
</StarlightPage>

<style>
  /* This page's content wants the full main-pane width Starlight already
     grants when there is no table of contents, not the site's usual prose
     cap - ContentPanel.astro's .sl-container isn't rendered by this
     component, so :global() plus :has() is what reaches it without loosening
     the cap on every other page.

     The match has to start at <main>, not at the container holding this
     page's own markup: Page.astro renders the <h1> in a *separate*
     .content-panel > .sl-container, so a :has(.playground-root) test only
     ever sees the second one. Left capped at --sl-content-width and centred
     by ContentPanel's `margin-inline: auto` (>= 72rem), the title container
     is narrower than the panel below it, and the heading ends up indented
     from everything else on the page. Uncapping both containers puts them
     on the same left edge; auto margins then resolve to 0 on their own. */
  :global(main:has(.playground-root) .sl-container) {
    max-width: none;
  }

  /* <StarlightPage> always renders its content through <MarkdownContent>
     (Page.astro), even for a fully custom page like this one - there is no
     opt-out. That wraps everything in .sl-markdown-content, whose prose
     spacing rules reach straight into CodeMirror's own internal DOM: every
     .cm-line and .cm-gutterElement is a plain <div>, so each one picks up a
     stray margin-top from markdown.css's lobotomized-owl "* + *" selector.
     Starlight's own escape hatch for embedded UI is the .not-content class
     on the wrapper (every one of those rules excludes ":where(.not-content
     *)"), which is what the root carries - see the markup above.

     Do NOT "fix" this instead with a blanket `margin-top: 0 !important`
     under this root: CodeMirror positions the first gutter element of the
     rendered viewport with an inline margin-top (GutterElement.update in
     @codemirror/view), so an !important reset wins over it and the line
     numbers slide out of sync with their lines on every scroll. */

  /* The side-by-side split has to collapse on the pane's own width, not the
     viewport's: Starlight drops its 18rem sidebar somewhere around 800px, so
     a window getting *narrower* hands this page ~250px more room right at
     that point, and any `@media (max-width: ...)` tuned for the wide case
     stacks the panes exactly where they just got roomier. Measured, the split
     runs about `viewport - 300px` while the sidebar is up and about
     `viewport - 48px` once it folds away. A container query reads the width
     that actually exists, so the two layouts stay in sync with the sidebar
     for free - see the @container rule below the .divider styles. */
  .playground-root {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    container-type: inline-size;
    container-name: playground;
  }

  /* The editor's palette. Starlight's own --sl-color-{green,purple,...} hues
     are tuned as prose accents - 82% saturation against a page that shows one
     at a time - and a whole screen of markup painted in them reads as neon.
     These are the same family (hue 224 greys, matched to the site chrome) at
     saturations that stay legible for a solid wall of text. Every syntax
     colour clears 4.5:1 against its own background, and stays above 4:1 over
     the active-line tint; the line numbers sit a little under that on
     purpose, so they stay secondary to the code they label.

     Dark is the default set and [data-theme='light'] overrides it, mirroring
     how Starlight's own props.css is layered, so the editor follows the site's
     theme toggle with no JS and no flash on load. Every value is consumed
     through var() by EditorView.theme and HighlightStyle down in the script. */
  .playground-root {
    --cm-punct: hsl(224, 12%, 65%);
    --cm-tag: hsl(205, 70%, 72%);
    --cm-attr: hsl(280, 55%, 80%);
    --cm-value: hsl(140, 45%, 70%);
    --cm-comment: hsl(224, 10%, 60%);
    --cm-meta: hsl(38, 70%, 70%);
    --cm-invalid: hsl(355, 75%, 72%);

    --cm-gutter-text: hsl(224, 10%, 55%);
    --cm-active-line: hsl(224, 14%, 21%);
    --cm-selection: hsl(224, 40%, 36%);
    --cm-match: hsl(224, 20%, 32%);
    --cm-cursor: hsl(205, 85%, 72%);
  }

  :global([data-theme="light"]) .playground-root {
    --cm-punct: hsl(224, 10%, 38%);
    --cm-tag: hsl(211, 70%, 34%);
    --cm-attr: hsl(283, 45%, 40%);
    --cm-value: hsl(152, 62%, 25%);
    --cm-comment: hsl(224, 9%, 40%);
    --cm-meta: hsl(28, 70%, 32%);
    --cm-invalid: hsl(355, 72%, 40%);

    --cm-gutter-text: hsl(224, 8%, 50%);
    --cm-active-line: hsl(224, 25%, 93%);
    --cm-selection: hsl(224, 70%, 85%);
    --cm-match: hsl(224, 45%, 84%);
    --cm-cursor: hsl(211, 80%, 42%);
  }

  .intro {
    margin: 0;
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .toolbar select {
    font: inherit;
    padding: 0.25rem 0.5rem;
  }

  /* The Settings disclosure sits inline in the toolbar's flex row while
     closed, sized to its <summary> like the template <select> beside it.
     Opened, it needs the full row rather than being squeezed into whatever
     flex track is left over. */
  .toolbar-settings {
    flex-basis: auto;
  }

  .toolbar-settings[open] {
    flex-basis: 100%;
  }

  .toolbar summary {
    cursor: pointer;
    font: inherit;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.25rem;
  }

  .toolbar summary:hover {
    border-color: var(--sl-color-text-accent);
  }

  .settings-panel {
    padding-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .settings-panel details {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.25rem;
    padding: 0.5rem 0.75rem;
  }

  /* One label/control pair per row by default. Wider containers repeat the
     pair as 2 or 3 side-by-side column groups instead of leaving a long
     single column of rows in all that spare width - grid auto-placement
     fills row-major, so the label/control/label/control... DOM order lines
     up into pairs on its own with no per-field markup change needed. */
  .settings-grid {
    display: grid;
    grid-template-columns: minmax(10rem, max-content) 1fr;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  @container playground (min-width: 640px) {
    .settings-grid {
      grid-template-columns: repeat(2, minmax(10rem, max-content) 1fr);
      column-gap: 1.5rem;
    }
  }

  @container playground (min-width: 960px) {
    .settings-grid {
      grid-template-columns: repeat(3, minmax(10rem, max-content) 1fr);
    }
  }

  .settings-grid select,
  .settings-grid input[type="number"],
  .settings-grid input[type="text"] {
    font: inherit;
    padding: 0.25rem 0.5rem;
    width: 100%;
    max-width: 12rem;
  }

  .settings-grid input[type="checkbox"] {
    justify-self: start;
  }

  .settings-grid input[type="color"] {
    padding: 0;
    width: 3rem;
    height: 1.75rem;
  }

  .settings-reset {
    align-self: flex-start;
    font: inherit;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
  }

  .settings-reset:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }

  .split {
    display: flex;
    flex-direction: row;
    height: min(75vh, 640px);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .pane {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    overflow: auto;
  }

  .editor-pane :global(.cm-editor) {
    height: 100%;
  }

  .preview-pane {
    background: #fff;
    padding: 0.75rem;
  }

  .preview-pane :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 0.75rem;
  }

  .divider {
    flex: none;
    width: 6px;
    background: var(--sl-color-hairline);
    cursor: col-resize;
    touch-action: none;
  }

  .divider:hover,
  .divider:active {
    background: var(--sl-color-text-accent);
  }

  /* 880px is two 437px panes. The editor sets 13px monospace, so a pane
     narrower than that shows under ~55 columns once the line-number gutter
     takes its share - less than the example files' own longest lines, which
     means horizontal scrolling to read the markup you are editing. Stacked,
     each pane gets the full width instead, and the divider trades what it
     splits. */
  @container playground (max-width: 880px) {
    .split {
      flex-direction: column;
      /* Two panes share this height rather than sitting side by side in it,
         so the row-mode 640px would leave about 317px each. */
      height: min(80vh, 800px);
    }

    .divider {
      width: auto;
      height: 6px;
      cursor: row-resize;
    }
  }

  .status {
    margin: 0;
    min-height: 1.5em;
    color: var(--sl-color-red, #c53030);
    white-space: pre-wrap;
    font-family: var(--__sl-font-mono, monospace);
    font-size: 0.85rem;
  }
</style>

<script>
  import { EditorView, basicSetup } from "codemirror";
  import { xml } from "@codemirror/lang-xml";
  import { HighlightStyle, syntaxHighlighting } from "@codemirror/language";
  import { tags as t } from "@lezer/highlight";
  import { parse } from "../../../renderer/src/parse.mjs";
  import { layout } from "../../../renderer/src/layout.mjs";
  import { draw } from "../../../renderer/src/draw.mjs";
  import { ready } from "../../../renderer/src/ready.mjs";
  import { defaults } from "../../../renderer/src/settings.mjs";

  // Only the examples the docs themselves link to (see renderer/HANDOVER.md)
  // - the "-test.txml" fixtures are internal stress tests, not something to
  // hand a first-time visitor.
  const templates = import.meta.glob("../../../renderer/examples/*.txml", {
    query: "?raw",
    import: "default",
    eager: true,
  });
  const templateSource = (file: string) => {
    const entry = Object.entries(templates).find(([path]) =>
      path.endsWith(`/${file}`),
    );
    if (!entry) throw new Error(`playground: no renderer/examples/${file}`);
    return String(entry[1]);
  };

  const editorPane = document.getElementById("editor-pane")!;
  const previewPane = document.getElementById("preview-pane")!;
  const statusEl = document.getElementById("status")!;
  const templateSelect = document.getElementById(
    "template-select",
  ) as HTMLSelectElement;
  const split = document.getElementById("split")!;
  const divider = document.getElementById("divider")!;
  const settingsCommonGrid = document.getElementById("settings-common")!;
  const settingsDetailsGrid = document.getElementById("settings-details")!;
  const settingsAdvancedGrid = document.getElementById("settings-advanced")!;
  const settingsResetButton = document.getElementById(
    "settings-reset",
  ) as HTMLButtonElement;

  // --- Rendering settings panel ---
  //
  // renderer/src/settings.mjs's `defaults` is the single source of truth for
  // every value below - a field never hard-codes its own default, it reads
  // one out of `defaults` via `path`. Two keys are deliberately not exposed
  // here: `measuresPerRow` (its own comment says "Fixed by 'The measure
  // grid'" - normative, not a style choice) and `fontFamily` (draw.mjs
  // embeds actual Sarabun font bytes via @font-face regardless of this
  // string, so a control for it would just mislead).

  type Tier = "common" | "details" | "advanced";
  type FieldType = "checkbox" | "number" | "text" | "color" | "select";

  interface FieldOption {
    value: string;
    label: string;
  }

  interface FieldDef {
    path: string;
    tier: Tier;
    type: FieldType;
    label: string;
    min?: number;
    max?: number;
    step?: number;
    options?: FieldOption[];
    decode?: (raw: string) => unknown;
    encode?: (value: unknown) => string;
    validate?: (value: unknown) => boolean;
  }

  const FIELDS: FieldDef[] = [
    // --- common ---
    {
      path: "pitchSpelling",
      tier: "common",
      type: "select",
      label: "การสะกดระดับเสียง",
      options: [
        { value: "source", label: "ตามที่เขียนไว้" },
        { value: "thai", label: "ไทย" },
        { value: "letter", label: "อักษรโรมัน" },
        { value: "number", label: "ตัวเลข" },
      ],
    },
    {
      // layout.mjs only ever branches on pitchCase === "upper" - there is no
      // implemented "force lowercase" - so this is a checkbox rather than a
      // select offering a choice the renderer doesn't actually have.
      path: "pitchCase",
      tier: "common",
      type: "checkbox",
      label: "บังคับอักษรโรมันเป็นตัวพิมพ์ใหญ่",
      decode: (raw) => (raw === "true" ? "upper" : "source"),
      encode: (value) => String(value === "upper"),
    },
    {
      path: "printRests",
      tier: "common",
      type: "select",
      label: "ตัวหยุด",
      options: [
        { value: "all", label: "พิมพ์ตัวหยุดทุกตัว" },
        { value: "none", label: "ซ่อนตัวหยุด" },
      ],
    },
    {
      path: "generateHeadings",
      tier: "common",
      type: "checkbox",
      label: "สร้างหัวเรื่องท่อนอัตโนมัติ",
    },

    // --- details ---
    {
      path: "restGlyph",
      tier: "details",
      type: "text",
      label: "สัญลักษณ์ตัวหยุด",
    },
    {
      path: "showHeaderExtras",
      tier: "details",
      type: "checkbox",
      label: "แสดงการตั้งเสียง ใบอนุญาต และ BPM",
    },
    {
      path: "headerExtraSize",
      tier: "details",
      type: "number",
      label: "ขนาดข้อมูลเสริมส่วนหัว",
      min: 1,
      step: 1,
    },
    {
      path: "showLabels",
      tier: "details",
      type: "select",
      label: "ป้ายชื่อเครื่องดนตรี",
      options: [
        { value: "auto", label: "อัตโนมัติ (เฉพาะวงรวม)" },
        { value: "true", label: "แสดงเสมอ" },
        { value: "false", label: "ซ่อนเสมอ" },
      ],
      decode: (raw) => (raw === "auto" ? null : raw === "true"),
      encode: (value) => (value === null ? "auto" : String(value)),
      validate: (value) => value === null || typeof value === "boolean",
    },
    {
      path: "labelSize",
      tier: "details",
      type: "number",
      label: "ขนาดป้ายชื่อ",
      min: 1,
      step: 1,
    },
    {
      path: "dimParenthesisDefault",
      tier: "details",
      type: "checkbox",
      label: "หรี่ช่วงที่อ้างอิงเป็นค่าเริ่มต้น",
    },
    {
      // The default "#999" is 3-digit shorthand; <input type="color"> needs
      // 6-digit. Expand it for display only - the stored/default value stays
      // "#999", which is equally valid CSS/SVG.
      path: "dimColor",
      tier: "details",
      type: "color",
      label: "สีหรี่",
      encode: (value) =>
        typeof value === "string" && value.length === 4
          ? value[0] + value[1] + value[1] + value[2] + value[2] + value[3] + value[3]
          : String(value),
    },
    {
      path: "titleSize",
      tier: "details",
      type: "number",
      label: "ขนาดชื่อเรื่อง",
      min: 1,
      step: 1,
    },
    {
      path: "instrumentNameSize",
      tier: "details",
      type: "number",
      label: "ขนาดชื่อเครื่องดนตรี",
      min: 1,
      step: 1,
    },
    {
      path: "creditSize",
      tier: "details",
      type: "number",
      label: "ขนาดเครดิต",
      min: 1,
      step: 1,
    },
    {
      path: "pitchSize",
      tier: "details",
      type: "number",
      label: "ขนาดตัวโน้ต",
      min: 1,
      step: 1,
    },
    {
      path: "lyricSize",
      tier: "details",
      type: "number",
      label: "ขนาดเนื้อเพลง",
      min: 1,
      step: 1,
    },
    {
      path: "annotationSize",
      tier: "details",
      type: "number",
      label: "ขนาดหมายเหตุประกอบ",
      min: 1,
      step: 1,
    },

    // --- advanced ---
    {
      path: "page.width",
      tier: "advanced",
      type: "number",
      label: "ความกว้างหน้ากระดาษ (pt)",
      min: 0,
      step: 1,
    },
    {
      path: "page.height",
      tier: "advanced",
      type: "number",
      label: "ความสูงหน้ากระดาษ (pt)",
      min: 0,
      step: 1,
    },
    {
      path: "page.margin",
      tier: "advanced",
      type: "number",
      label: "ขอบหน้ากระดาษ (pt)",
      min: 0,
      step: 1,
    },
    {
      path: "rowHeight",
      tier: "advanced",
      type: "number",
      label: "ความสูงแถว",
      min: 0,
      step: 1,
    },
    {
      path: "octaveDotRadius",
      tier: "advanced",
      type: "number",
      label: "รัศมีจุด octave",
      min: 0,
      step: 0.01,
    },
    {
      path: "octaveDotGapAbove",
      tier: "advanced",
      type: "number",
      label: "ระยะห่างจุด octave ด้านบน",
      min: 0,
      step: 0.01,
    },
    {
      path: "octaveDotGapBelow",
      tier: "advanced",
      type: "number",
      label: "ระยะห่างจุด octave ด้านล่าง",
      min: 0,
      step: 0.01,
    },
    {
      path: "spread",
      tier: "advanced",
      type: "number",
      label: "ระยะกระจายสัญลักษณ์",
      min: 0,
      step: 0.01,
    },
    {
      path: "linkTop",
      tier: "advanced",
      type: "number",
      label: "ความสูงเส้นโยง",
      min: 0,
      step: 0.01,
    },
    {
      path: "linkSideStep",
      tier: "advanced",
      type: "number",
      label: "ระยะเยื้องเส้นโยง",
      min: 0,
      step: 0.01,
    },
    {
      path: "linkRise",
      tier: "advanced",
      type: "number",
      label: "ความโค้งเส้นโยง",
      min: 0,
      step: 0.01,
    },
    {
      path: "linkStroke",
      tier: "advanced",
      type: "number",
      label: "ความหนาเส้นโยง",
      min: 0,
      step: 0.1,
    },
    {
      path: "groupTightness",
      tier: "advanced",
      type: "number",
      label: "ความชิดของกลุ่ม",
      min: 0,
      step: 0.01,
    },
    {
      path: "minSymbolAdvance",
      tier: "advanced",
      type: "number",
      label: "ระยะห่างต่ำสุดระหว่างสัญลักษณ์",
      min: 0,
      step: 0.01,
    },
    {
      path: "gapScale.0",
      tier: "advanced",
      type: "number",
      label: "ช่องว่างระหว่างแถว",
      min: 0,
      step: 1,
    },
    {
      path: "gapScale.1",
      tier: "advanced",
      type: "number",
      label: "ช่องว่างระหว่างเครื่องดนตรี",
      min: 0,
      step: 1,
    },
    {
      path: "gapScale.2",
      tier: "advanced",
      type: "number",
      label: "ช่องว่างระหว่างบรรทัด",
      min: 0,
      step: 1,
    },
    {
      path: "gapScale.3",
      tier: "advanced",
      type: "number",
      label: "ช่องว่างระหว่างท่อน",
      min: 0,
      step: 1,
    },
    {
      path: "annotationGap",
      tier: "advanced",
      type: "number",
      label: "ช่องว่างหมายเหตุประกอบ",
      min: 0,
      step: 1,
    },
    {
      path: "annotationLeading",
      tier: "advanced",
      type: "number",
      label: "ระยะบรรทัดหมายเหตุประกอบ",
      min: 0,
      step: 0.01,
    },
    {
      path: "titleGap",
      tier: "advanced",
      type: "number",
      label: "ช่องว่างใต้ชื่อเรื่อง",
      min: 0,
      step: 1,
    },
    {
      path: "bandGap",
      tier: "advanced",
      type: "number",
      label: "ช่องว่างแถบหัวเรื่อง",
      min: 0,
      step: 1,
    },
    {
      path: "bowTop",
      tier: "advanced",
      type: "number",
      label: "ความสูงเส้นโค้งคันชัก",
      min: 0,
      step: 0.01,
    },
    {
      path: "bowRise",
      tier: "advanced",
      type: "number",
      label: "ความโค้งคันชัก",
      min: 0,
      step: 0.01,
    },
    {
      path: "bowStroke",
      tier: "advanced",
      type: "number",
      label: "ความหนาเส้นคันชัก",
      min: 0,
      step: 0.1,
    },
    {
      path: "bowMinSpan",
      tier: "advanced",
      type: "number",
      label: "ระยะขั้นต่ำคันชัก",
      min: 0,
      step: 0.1,
    },
    {
      path: "labelGap",
      tier: "advanced",
      type: "number",
      label: "ช่องว่างป้ายชื่อ",
      min: 0,
      step: 0.01,
    },
    {
      path: "repeatBracketGap",
      tier: "advanced",
      type: "number",
      label: "ช่องว่างวงเล็บซ้ำ",
      min: 0,
      step: 0.01,
    },
    {
      path: "repeatBracketDepth",
      tier: "advanced",
      type: "number",
      label: "ความลึกวงเล็บซ้ำ",
      min: 0,
      step: 0.01,
    },
    {
      path: "repeatBracketStroke",
      tier: "advanced",
      type: "number",
      label: "ความหนาเส้นวงเล็บซ้ำ",
      min: 0,
      step: 0.1,
    },
    {
      path: "repeatLabelSize",
      tier: "advanced",
      type: "number",
      label: "ขนาดป้ายซ้ำ",
      min: 1,
      step: 1,
    },
  ];

  function getPath(obj: any, path: string): unknown {
    return path.split(".").reduce((o, k) => (o == null ? undefined : o[k]), obj);
  }

  function setPath(obj: any, path: string, value: unknown): void {
    const keys = path.split(".");
    const last = keys.pop()!;
    keys.reduce((o, k) => o[k], obj)[last] = value;
  }

  function defaultValidate(field: FieldDef, value: unknown): boolean {
    switch (field.type) {
      case "checkbox":
        return typeof value === "boolean";
      case "number":
        return typeof value === "number" && Number.isFinite(value);
      case "text":
        return typeof value === "string";
      case "color":
        return typeof value === "string" && /^#[0-9a-f]{6}$/i.test(value);
      case "select":
        // A select with no decode() stores one of its own option values
        // directly. One that decodes (e.g. showLabels) supplies its own
        // field.validate instead of relying on this default.
        return field.options!.some((opt) => opt.value === value);
    }
  }

  const STORAGE_KEY = "thaimusicxml-playground-settings";

  function loadOverrides(): Record<string, unknown> {
    const overrides: Record<string, unknown> = {};
    for (const field of FIELDS) overrides[field.path] = getPath(defaults, field.path);

    let saved: unknown;
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) saved = JSON.parse(raw);
    } catch {
      saved = undefined;
    }
    if (saved && typeof saved === "object") {
      for (const field of FIELDS) {
        const value = (saved as Record<string, unknown>)[field.path];
        if (value === undefined) continue;
        const ok = field.validate ? field.validate(value) : defaultValidate(field, value);
        if (ok) overrides[field.path] = value;
      }
    }
    return overrides;
  }

  function saveOverrides(overrides: Record<string, unknown>): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(overrides));
    } catch {
      // Storage full or unavailable (private browsing) - settings just
      // won't persist; nothing else on the page depends on it.
    }
  }

  function buildOptions(overrides: Record<string, unknown>): Record<string, unknown> {
    // defaults is plain JSON-safe data, so a round-trip is a safe deep clone
    // - layout()/draw() each shallow-merge {...defaults, ...options}, so a
    // partial `page` object or `gapScale` array here would blank out
    // whichever sibling fields the user didn't just touch.
    const options = JSON.parse(JSON.stringify(defaults));
    for (const field of FIELDS) setPath(options, field.path, overrides[field.path]);
    return options;
  }

  const overrides = loadOverrides();
  const controlsByPath = new Map<string, HTMLInputElement | HTMLSelectElement>();

  // Appends a label and its control as two direct children of `grid` - not
  // wrapped in a row div - since .settings-grid's two-column template lays
  // out its direct children in label/control pairs, one pair per grid row.
  function buildFieldRow(grid: HTMLElement, field: FieldDef, onChange: () => void): void {
    const id = `setting-${field.path.replace(/\./g, "-")}`;

    const label = document.createElement("label");
    label.htmlFor = id;
    label.textContent = field.label;
    grid.appendChild(label);

    const current = overrides[field.path];
    let el: HTMLInputElement | HTMLSelectElement;

    if (field.type === "select") {
      const select = document.createElement("select");
      select.id = id;
      for (const opt of field.options!) {
        const o = document.createElement("option");
        o.value = opt.value;
        o.textContent = opt.label;
        select.appendChild(o);
      }
      select.value = field.encode ? field.encode(current) : String(current);
      select.addEventListener("change", () => {
        overrides[field.path] = field.decode ? field.decode(select.value) : select.value;
        onChange();
      });
      el = select;
    } else {
      const input = document.createElement("input");
      input.id = id;
      input.type = field.type;
      if (field.type === "number") {
        if (field.min !== undefined) input.min = String(field.min);
        if (field.max !== undefined) input.max = String(field.max);
        if (field.step !== undefined) input.step = String(field.step);
      }
      if (field.type === "checkbox") {
        input.checked = Boolean(current);
      } else {
        input.value = field.encode ? field.encode(current) : String(current);
      }
      const eventName = field.type === "checkbox" ? "change" : "input";
      input.addEventListener(eventName, () => {
        overrides[field.path] =
          field.type === "checkbox"
            ? input.checked
            : field.type === "number"
              ? Number(input.value)
              : input.value;
        onChange();
      });
      el = input;
    }

    controlsByPath.set(field.path, el);
    grid.appendChild(el);
  }

  // Two bugs in one theme: the site's own `body { line-height: 1.75 }`
  // (reset.css, meant for prose) inherits into .cm-content and stretches
  // every code line; and CodeMirror's default chrome is a plain light theme
  // with no idea the site has a dark mode, so `html { color-scheme: dark }`
  // (also reset.css) makes the browser's own dark-mode heuristics repaint
  // whatever CodeMirror left unstyled, clashing with syntax colors picked for
  // a white background. Both the chrome below and the highlight style after it
  // are painted from CSS custom properties (--sl-* where a site token is the
  // right answer, --cm-* from this page's own palette otherwise), so one theme
  // object covers light and dark and the toggle costs no JS - see the palette
  // block in this page's <style>.
  const editorTheme = EditorView.theme({
    "&": {
      height: "100%",
      fontSize: "13px",
      backgroundColor: "var(--sl-color-bg-nav)",
      color: "var(--sl-color-text)",
    },
    ".cm-scroller": { fontFamily: "var(--__sl-font-mono, monospace)" },
    ".cm-content": {
      lineHeight: "1.4",
      caretColor: "var(--cm-cursor)",
    },
    ".cm-gutters": {
      backgroundColor: "var(--sl-color-bg-nav)",
      color: "var(--cm-gutter-text)",
      border: "none",
    },
    ".cm-gutterElement": { lineHeight: "1.4" },
    // Code folding is not something this playground needs, and its chevron
    // column only adds noise next to the line numbers.
    ".cm-foldGutter": { display: "none" },
    ".cm-activeLine": { backgroundColor: "var(--cm-active-line)" },
    ".cm-activeLineGutter": {
      backgroundColor: "var(--cm-active-line)",
      color: "var(--sl-color-text)",
    },
    // The selection has to stay visible *on top of* the active-line tint, so
    // these two can't be the same token the way they were.
    ".cm-selectionBackground, &.cm-focused .cm-selectionBackground": {
      backgroundColor: "var(--cm-selection)",
    },
    "&.cm-focused .cm-matchingBracket, .cm-matchingBracket": {
      backgroundColor: "var(--cm-match)",
      outline: "none",
    },
    ".cm-selectionMatch": { backgroundColor: "var(--cm-match)" },
    ".cm-cursor, .cm-dropCursor": { borderLeftColor: "var(--cm-cursor)" },
    // basicSetup also brings the search panel and the completion tooltip,
    // both of which default to light-only chrome that has to be reclaimed the
    // same way as the editor's own.
    ".cm-panels": {
      backgroundColor: "var(--sl-color-bg-nav)",
      color: "var(--sl-color-text)",
    },
    ".cm-panels.cm-panels-top": {
      borderBottomColor: "var(--sl-color-hairline)",
    },
    ".cm-panels.cm-panels-bottom": {
      borderTopColor: "var(--sl-color-hairline)",
    },
    ".cm-panel input, .cm-panel button": { font: "inherit" },
    ".cm-tooltip": {
      backgroundColor: "var(--sl-color-bg-nav)",
      border: "1px solid var(--sl-color-hairline)",
      color: "var(--sl-color-text)",
    },
    ".cm-tooltip-autocomplete > ul > li[aria-selected]": {
      backgroundColor: "var(--cm-selection)",
      color: "var(--sl-color-white)",
    },
    ".cm-searchMatch": { backgroundColor: "var(--cm-match)" },
    ".cm-searchMatch.cm-searchMatch-selected": {
      backgroundColor: "var(--cm-selection)",
    },
  });

  // @lezer/xml tags every token this style needs (see xmlHighlighting in
  // @lezer/xml): angle brackets and `=` are punctuation, so they recede;
  // tag names carry the structure and get the strongest colour; attribute
  // names and their values stay distinct from each other and from the tags.
  // basicSetup registers CodeMirror's stock highlight style as a *fallback*
  // only (`syntaxHighlighting(defaultHighlightStyle, { fallback: true })`),
  // so registering any real one here replaces it outright rather than
  // layering two sets of colours on the same tokens.
  const editorHighlight = HighlightStyle.define([
    { tag: t.tagName, color: "var(--cm-tag)" },
    { tag: [t.angleBracket, t.definitionOperator], color: "var(--cm-punct)" },
    { tag: t.attributeName, color: "var(--cm-attr)" },
    { tag: [t.attributeValue, t.special(t.string)], color: "var(--cm-value)" },
    {
      tag: [t.processingInstruction, t.documentMeta, t.character],
      color: "var(--cm-meta)",
    },
    { tag: t.blockComment, color: "var(--cm-comment)", fontStyle: "italic" },
    { tag: t.content, color: "var(--sl-color-text)" },
    // Last, so that a mismatched close tag - which @lezer/xml tags as both
    // tagName and invalid - lands on this rule rather than the tag colour.
    { tag: t.invalid, color: "var(--cm-invalid)" },
  ]);

  let renderTimer: ReturnType<typeof setTimeout> | undefined;
  const scheduleRender = () => {
    clearTimeout(renderTimer);
    renderTimer = setTimeout(renderPreview, 400);
  };

  const onSettingChange = () => {
    saveOverrides(overrides);
    scheduleRender();
  };
  for (const field of FIELDS.filter((f) => f.tier === "common"))
    buildFieldRow(settingsCommonGrid, field, onSettingChange);
  for (const field of FIELDS.filter((f) => f.tier === "details"))
    buildFieldRow(settingsDetailsGrid, field, onSettingChange);
  for (const field of FIELDS.filter((f) => f.tier === "advanced"))
    buildFieldRow(settingsAdvancedGrid, field, onSettingChange);

  settingsResetButton.addEventListener("click", () => {
    localStorage.removeItem(STORAGE_KEY);
    for (const field of FIELDS) {
      const value = getPath(defaults, field.path);
      overrides[field.path] = value;
      const el = controlsByPath.get(field.path)!;
      if (field.type === "checkbox") {
        (el as HTMLInputElement).checked = Boolean(value);
      } else {
        el.value = field.encode ? field.encode(value) : String(value);
      }
    }
    saveOverrides(overrides);
    scheduleRender();
  });

  const view = new EditorView({
    doc: templateSource("example-khaek-borathes.txml"),
    extensions: [
      basicSetup,
      xml(),
      editorTheme,
      syntaxHighlighting(editorHighlight),
      EditorView.updateListener.of((update) => {
        if (update.docChanged) scheduleRender();
      }),
    ],
    parent: editorPane,
  });

  templateSelect.addEventListener("change", () => {
    view.dispatch({
      changes: {
        from: 0,
        to: view.state.doc.length,
        insert: templateSource(templateSelect.value),
      },
    });
  });

  function renderPreview() {
    const source = view.state.doc.toString();
    const options = buildOptions(overrides);
    try {
      const laidOut = layout(parse(source), options);
      const svgs = laidOut.pages.map((page: { elements: unknown }) =>
        draw(
          {
            width: laidOut.width,
            height: laidOut.height,
            elements: page.elements,
          },
          options,
        ),
      );
      previewPane.innerHTML = svgs.join("");
      statusEl.textContent = "";
    } catch (err) {
      statusEl.textContent = err instanceof Error ? err.message : String(err);
    }
  }

  // --- Draggable divider: splits horizontally while the panes sit side by
  // side, vertically once they stack. ---
  let ratio = 0.5;
  const applyRatio = () => {
    (editorPane as HTMLElement).style.flexGrow = String(ratio);
    (previewPane as HTMLElement).style.flexGrow = String(1 - ratio);
  };
  applyRatio();

  // Asking the layout which way it went, rather than re-testing the width
  // here: the switch is a container query now (see the <style> block), and
  // matchMedia cannot express one. Reading the resolved flex-direction also
  // means the drag axis cannot drift from the CSS if the threshold moves.
  const isRow = () => getComputedStyle(split).flexDirection === "row";
  let dragging = false;
  divider.addEventListener("pointerdown", (e) => {
    dragging = true;
    divider.setPointerCapture(e.pointerId);
  });
  divider.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    const rect = split.getBoundingClientRect();
    const pos = isRow()
      ? (e.clientX - rect.left) / rect.width
      : (e.clientY - rect.top) / rect.height;
    ratio = Math.min(0.85, Math.max(0.15, pos));
    applyRatio();
  });
  const stopDrag = (e: PointerEvent) => {
    dragging = false;
    divider.releasePointerCapture(e.pointerId);
  };
  divider.addEventListener("pointerup", stopDrag);
  divider.addEventListener("pointercancel", stopDrag);

  await ready();
  renderPreview();
</script>
