---
const enUrl = "/en/";
const thUrl = "/th/";
const canonical = "https://thaimusicxml.anan.ovh/en/";
const title = "ThaiMusicXML";
const description = "มาตรฐานโน้ตดนตรีไทยในรูปแบบดิจิทัล | An open digital notation standard for Thai Traditional Music";
const image = "https://thaimusicxml.anan.ovh/ThaiMusicXMLOG.png";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en" href="https://thaimusicxml.anan.ovh/en/" />
		<link rel="alternate" hreflang="th" href="https://thaimusicxml.anan.ovh/th/" />
		<link rel="alternate" hreflang="x-default" href="https://thaimusicxml.anan.ovh/en/" />
		<link rel="icon" href="/favicon.ico" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<!-- Fast redirect for real browsers -->
		<script is:inline define:vars={{ enUrl, thUrl }}>
			var lang = (navigator.language || "en").toLowerCase();
			var target = lang.startsWith("th") ? thUrl : enUrl;
			location.replace(target);
		</script>
		<!-- Fallback redirect for crawlers that do not run JavaScript -->
		<meta http-equiv="refresh" content={`0; url=${enUrl}`} />
	</head>
	<body>
		<h1>{title}</h1>
		<p>{description}</p>
		<p>
			<a href={enUrl}>Continue in English</a> &middot;
			<a href={thUrl}>ไปหน้าภาษาไทย</a>
		</p>
	</body>
</html>
