---
const enUrl = "/en/";
const thUrl = "/th/";
const canonical = "https://thaimusicxml.anan.ovh/en/";
const title = "ThaiMusicXML";
const description = "มาตรฐานโน้ตดนตรีไทยในรูปแบบดิจิทัล | An open digital notation standard for Thai Traditional Music";
const image = "https://thaimusicxml.anan.ovh/ThaiMusicXMLOG.png";

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "TechArticle",
		name: "ThaiMusicXML Specification",
		headline: "ThaiMusicXML: An open digital notation standard for Thai Traditional Music",
		description:
			"ThaiMusicXML is an open, royalty-free XML file format for Thai traditional music (เพลงไทยเดิม). It records notation in a form software can validate, search, print, and exchange without tying scores to any single editor.",
		url: "https://thaimusicxml.anan.ovh/en/",
		inLanguage: ["en", "th"],
		author: {
			"@type": "Person",
			name: "Nopparuj Ananvoranich",
			url: "https://anan.ovh/",
		},
		license: "https://github.com/Nopparuj-an/ThaiMusicXML/blob/main/LICENSE.txt",
		codeRepository: "https://github.com/Nopparuj-an/ThaiMusicXML",
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "ThaiMusicXML",
		url: "https://thaimusicxml.anan.ovh/",
		description:
			"Documentation site for ThaiMusicXML, an open digital notation standard for Thai Traditional Music.",
	},
];

const sections = [
	{ href: "/en/introduction/", label: "Introduction", th: "บทนำ" },
	{ href: "/en/tutorial/1-hello_world/", label: "Tutorial", th: "บทช่วยสอน" },
	{ href: "/en/reference/elements/", label: "Elements reference", th: "องค์ประกอบ" },
	{ href: "/en/reference/conformance/", label: "Conformance", th: "ความสอดคล้อง" },
	{ href: "/en/reference/rendering/", label: "Rendering", th: "การแสดงผล" },
	{ href: "/en/reference/schema/", label: "Schema and test suite", th: "Schema และชุดทดสอบ" },
	{ href: "/en/reference/conversion/", label: "Conversion", th: "การแปลงไฟล์" },
	{ href: "/en/reference/examples/", label: "Examples", th: "ตัวอย่าง" },
	{ href: "/en/playground/", label: "Playground", th: "สนามทดลอง" },
	{ href: "/en/about/", label: "About", th: "เกี่ยวกับ" },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en" href="https://thaimusicxml.anan.ovh/en/" />
		<link rel="alternate" hreflang="th" href="https://thaimusicxml.anan.ovh/th/" />
		<link rel="alternate" hreflang="x-default" href="https://thaimusicxml.anan.ovh/en/" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<!--
			Language routing for real browsers only. Crawlers and fetchers that do not
			run JavaScript fall through to the body below, which carries the full
			description of the format in both languages rather than a redirect stub.
		-->
		<script is:inline define:vars={{ enUrl, thUrl }}>
			var lang = (navigator.language || "en").toLowerCase();
			var target = lang.startsWith("th") ? thUrl : enUrl;
			location.replace(target);
		</script>

		<style>
			body {
				max-width: 46rem;
				margin: 0 auto;
				padding: 2rem 1.25rem 4rem;
				font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
				line-height: 1.7;
				color: #1c1e21;
				background: #fff;
			}
			h1 { font-size: 2rem; margin-bottom: 0.25rem; }
			h2 { font-size: 1.35rem; margin-top: 2.5rem; }
			.tagline { color: #4a4f55; margin-top: 0; }
			nav ul { padding-left: 1.2rem; }
			@media (prefers-color-scheme: dark) {
				body { color: #e7e9ea; background: #14161a; }
				.tagline { color: #a7adb5; }
				a { color: #8ab4f8; }
			}
		</style>
	</head>
	<body>
		<h1>ThaiMusicXML</h1>
		<p class="tagline">{description}</p>

		<p>
			<a href={enUrl}>Continue in English</a> &middot;
			<a href={thUrl}>ไปหน้าภาษาไทย</a>
		</p>

		<h2>What is ThaiMusicXML?</h2>

		<p>
			ThaiMusicXML is an open, royalty-free file format for Thai traditional music
			(เพลงไทยเดิม / Phleng Thai Doem). It records the notation Thai musicians already read,
			in a form software can validate, search, print, and hand to another program - without
			tying the score to any one editor.
		</p>

		<p>
			The format captures the 7-tone scale (ด ร ม ฟ ซ ล ท) as scale degrees rather than fixed
			pitches, the beat-grid that aligns every instrument down the page, rests as "no new
			stroke" rather than silence, unpitched rows for ฉิ่ง and other percussion, lyrics, bow
			and gesture curves, cued passages, and repeat marks. A file stays close to what a
			musician reads on paper and still parses as data - so a score can be archived,
			corrected, and printed again long after the program that wrote it is gone.
		</p>

		<p>
			The specification is published under
			<a href="https://github.com/Nopparuj-an/ThaiMusicXML/blob/main/LICENSE.txt"
				>Apache License 2.0</a
			>: free to use, adapt, and ship inside any application, open or closed source.
		</p>

		<h2>ThaiMusicXML คืออะไร?</h2>

		<p>
			ThaiMusicXML เป็นรูปแบบไฟล์แบบเปิดและไม่มีค่าลิขสิทธิ์สำหรับเพลงไทยเดิม
			บันทึกโน้ตอย่างที่นักดนตรีไทยอ่านกันอยู่แล้ว ในรูปแบบที่ซอฟต์แวร์ตรวจสอบ ค้นหา พิมพ์
			และส่งต่อไปยังโปรแกรมอื่นได้ โดยไม่ผูกโน้ตเพลงไว้กับโปรแกรมใดโปรแกรมหนึ่ง
		</p>

		<p>
			รูปแบบนี้บันทึกระบบเสียง 7 เสียง (ด ร ม ฟ ซ ล ท) ในฐานะลำดับขั้นเสียง ไม่ใช่ระดับเสียงตายตัว,
			ตารางจังหวะที่จัดแนวเครื่องดนตรีทุกชิ้นในแนวตั้ง, ตัวหยุดที่หมายถึงไม่มีการบรรเลงตัวใหม่,
			บรรทัดสำหรับฉิ่งและเครื่องดนตรีที่ไม่มีระดับเสียง, เนื้อร้อง, เส้นโค้งคันชักและสะบัด,
			วงเล็บช่วงที่รอ และเครื่องหมายซ้ำ ไฟล์จึงใกล้เคียงกับที่นักดนตรีอ่านจากกระดาษ
			และในขณะเดียวกันก็อ่านเป็นข้อมูลได้ โน้ตเพลงจะเก็บรักษา แก้ไข และพิมพ์ใหม่ได้
			แม้โปรแกรมที่สร้างไฟล์นั้นจะไม่มีอยู่แล้ว
		</p>

		<p>
			ข้อกำหนดมาตรฐานนี้เผยแพร่ภายใต้
			<a href="https://github.com/Nopparuj-an/ThaiMusicXML/blob/main/LICENSE.txt"
				>Apache License 2.0</a
			>: นำไปใช้งาน ดัดแปลง และเผยแพร่ต่อได้อย่างอิสระ ทั้งในโปรแกรมแบบเปิดและแบบปิดซอร์ส
		</p>

		<h2>Documentation / เอกสาร</h2>

		<nav>
			<ul>
				{
					sections.map((s) => (
						<li>
							<a href={s.href}>{s.label}</a> &middot;{" "}
							<a href={s.href.replace("/en/", "/th/")}>{s.th}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<p>
			Source code and issues:
			<a href="https://github.com/Nopparuj-an/ThaiMusicXML"
				>github.com/Nopparuj-an/ThaiMusicXML</a
			>
		</p>
	</body>
</html>
