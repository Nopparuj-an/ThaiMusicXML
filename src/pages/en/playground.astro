---
// A live editor + renderer preview: type ThaiMusicXML, see the score it draws.
// The renderer itself runs entirely client-side (see renderer/src/#font-loader
// and #dom-parser in package.json's "imports" for the Node/browser split), so
// this page needs no server and works the same offline as it does deployed.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Playground",
    tableOfContents: false,
    template: "splash",
  }}
>
  <div class="playground-root not-content">
    <p class="intro">
      Edit the ThaiMusicXML on the left and the score updates on the right. Pick
      a starting point below, or clear the editor and write your own.
    </p>

    <div class="toolbar">
      <label for="template-select">Template</label>
      <select id="template-select">
        <option value="example-khaek-borathes.txml">Example: แขกบรเทศ</option>
        <option value="example-sathukan.txml">Example: สาธุการ</option>
        <option value="example-chuen-chumnum.txml"
          >Example: ชื่นชุมนุม - กลุ่มดนตรี</option
        >
        <option value="example-chomsurang.txml"
          >Example: โหมโรงจอมสุรางค์</option
        >
        <option value="tutorial1-hello-world.txml"
          >Tutorial 1: Hello world</option
        >
        <option value="tutorial2-file-structure.txml"
          >Tutorial 2: File structure</option
        >
      </select>

      <button type="button" class="toolbar-button" id="import-button"
        >Import</button
      >
      <input
        type="file"
        id="import-file-input"
        accept=".txml,text/xml,application/xml"
        hidden
      />
      <button type="button" class="toolbar-button" id="save-button">Save</button
      >
      <span class="file-status" id="file-status"></span>

      <details class="toolbar-settings">
        <summary>Settings</summary>
        <div class="settings-panel">
          <div class="settings-grid" id="settings-common"></div>
          <details>
            <summary>More options</summary>
            <div class="settings-grid" id="settings-details"></div>
          </details>
          <details>
            <summary>Advanced</summary>
            <div class="settings-grid" id="settings-advanced"></div>
          </details>
          <button type="button" class="settings-reset" id="settings-reset"
            >Reset to defaults</button
          >
        </div>
      </details>

      <details class="toolbar-export">
        <summary>Export</summary>
        <div class="export-panel">
          <button type="button" id="export-txml">TXML</button>
          <button type="button" id="export-svg">SVG</button>
          <button type="button" id="export-png">PNG</button>
          <button type="button" id="export-pdf">PDF (print)</button>
        </div>
      </details>
    </div>

    <div class="split" id="split">
      <div class="pane editor-pane" id="editor-pane"></div>
      <div
        class="divider"
        id="divider"
        role="separator"
        aria-orientation="vertical"
        aria-label="Resize editor and preview"
      >
      </div>
      <div class="pane preview-pane" id="preview-pane"></div>
    </div>

    <p class="status" id="status" role="status"></p>
  </div>
</StarlightPage>

<style>
  /* This page's content wants the full main-pane width Starlight already
     grants when there is no table of contents, not the site's usual prose
     cap - ContentPanel.astro's .sl-container isn't rendered by this
     component, so :global() plus :has() is what reaches it without loosening
     the cap on every other page.

     The match has to start at <main>, not at the container holding this
     page's own markup: Page.astro renders the <h1> in a *separate*
     .content-panel > .sl-container, so a :has(.playground-root) test only
     ever sees the second one. Left capped at --sl-content-width and centred
     by ContentPanel's `margin-inline: auto` (>= 72rem), the title container
     is narrower than the panel below it, and the heading ends up indented
     from everything else on the page. Uncapping both containers puts them
     on the same left edge; auto margins then resolve to 0 on their own. */
  :global(main:has(.playground-root) .sl-container) {
    max-width: none;
  }

  /* <StarlightPage> always renders its content through <MarkdownContent>
     (Page.astro), even for a fully custom page like this one - there is no
     opt-out. That wraps everything in .sl-markdown-content, whose prose
     spacing rules would otherwise reach into the editor's own internal DOM.
     Starlight's own escape hatch for embedded UI is the .not-content class
     on the wrapper (every one of those rules excludes ":where(.not-content
     *)"), which is what the root carries - see the markup above. */

  /* The side-by-side split has to collapse on the pane's own width, not the
     viewport's: Starlight drops its 18rem sidebar somewhere around 800px, so
     a window getting *narrower* hands this page ~250px more room right at
     that point, and any `@media (max-width: ...)` tuned for the wide case
     stacks the panes exactly where they just got roomier. Measured, the split
     runs about `viewport - 300px` while the sidebar is up and about
     `viewport - 48px` once it folds away. A container query reads the width
     that actually exists, so the two layouts stay in sync with the sidebar
     for free - see the @container rule below the .divider styles. */
  .playground-root {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    container-type: inline-size;
    container-name: playground;
  }

  /* The editor's syntax palette lives in src/playground/monaco-theme.ts, not
     here - Monaco's theme API takes concrete colors, not CSS custom
     properties, so there is nothing for var() to consume on this side. */

  .intro {
    margin: 0;
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .toolbar select {
    font: inherit;
    padding: 0.25rem 0.5rem;
  }

  /* The Settings disclosure sits inline in the toolbar's flex row while
     closed, sized to its <summary> like the template <select> beside it.
     Opened, it needs the full row rather than being squeezed into whatever
     flex track is left over. */
  .toolbar-settings {
    flex-basis: auto;
  }

  .toolbar-settings[open] {
    flex-basis: 100%;
  }

  .toolbar-export {
    flex-basis: auto;
  }

  .export-panel {
    padding-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .export-panel button {
    font: inherit;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
  }

  .export-panel button:hover:not(:disabled) {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }

  .export-panel button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .toolbar summary {
    cursor: pointer;
    font: inherit;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.25rem;
  }

  .toolbar summary:hover {
    border-color: var(--sl-color-text-accent);
  }

  .settings-panel {
    padding-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .settings-panel details {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.25rem;
    padding: 0.5rem 0.75rem;
  }

  /* One label/control pair per row by default. Wider containers repeat the
     pair as 2 or 3 side-by-side column groups instead of leaving a long
     single column of rows in all that spare width - grid auto-placement
     fills row-major, so the label/control/label/control... DOM order lines
     up into pairs on its own with no per-field markup change needed. */
  .settings-grid {
    display: grid;
    grid-template-columns: minmax(10rem, max-content) 1fr;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  @container playground (min-width: 640px) {
    .settings-grid {
      grid-template-columns: repeat(2, minmax(10rem, max-content) 1fr);
      column-gap: 1.5rem;
    }
  }

  @container playground (min-width: 960px) {
    .settings-grid {
      grid-template-columns: repeat(3, minmax(10rem, max-content) 1fr);
    }
  }

  .settings-grid select,
  .settings-grid input[type="number"],
  .settings-grid input[type="text"] {
    font: inherit;
    padding: 0.25rem 0.5rem;
    width: 100%;
    max-width: 12rem;
  }

  .settings-grid input[type="checkbox"] {
    justify-self: start;
  }

  .settings-grid input[type="color"] {
    padding: 0;
    width: 3rem;
    height: 1.75rem;
  }

  .settings-reset {
    align-self: flex-start;
    font: inherit;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
  }

  .settings-reset:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }

  .toolbar-button {
    font: inherit;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
  }

  .toolbar-button:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }

  /* The dot mirrors the unsaved-buffer indicator most code editors use, so
     it reads at a glance without needing to parse the label text. */
  .file-status {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3, #888);
  }

  .split {
    display: flex;
    flex-direction: row;
    height: min(75vh, 640px);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .pane {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    overflow: auto;
  }

  /* Monaco sizes itself from the container's own box (automaticLayout: true
     in the script re-measures it on every resize) rather than needing a CSS
     rule the way CodeMirror did - it just must not get a second scrollbar
     from the .pane rule above fighting its own internal one. */
  .editor-pane {
    overflow: hidden;
  }

  .preview-pane {
    background: #fff;
    padding: 0.75rem;
  }

  .preview-pane :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 0.75rem;
  }

  .divider {
    flex: none;
    width: 6px;
    background: var(--sl-color-hairline);
    cursor: col-resize;
    touch-action: none;
  }

  .divider:hover,
  .divider:active {
    background: var(--sl-color-text-accent);
  }

  /* 880px is two 437px panes. The editor sets 13px monospace, so a pane
     narrower than that shows under ~55 columns once the line-number gutter
     takes its share - less than the example files' own longest lines, which
     means horizontal scrolling to read the markup you are editing. Stacked,
     each pane gets the full width instead, and the divider trades what it
     splits. */
  @container playground (max-width: 880px) {
    .split {
      flex-direction: column;
      /* Two panes share this height rather than sitting side by side in it,
         so the row-mode 640px would leave about 317px each. */
      height: min(80vh, 800px);
    }

    .divider {
      width: auto;
      height: 6px;
      cursor: row-resize;
    }
  }

  .status {
    margin: 0;
    min-height: 1.5em;
    color: var(--sl-color-red, #c53030);
    white-space: pre-wrap;
    font-family: var(--__sl-font-mono, monospace);
    font-size: 0.85rem;
  }
</style>

<script>
  // editor.api.js alone only defines the API surface (editor.create,
  // languages.register*) - the built-in features that surface (suggest
  // widget, hover widget, find, bracket matching...) are separate modules
  // registered as a side effect of importing editor.all.js, which
  // edcore.main.js re-exports editor.api.js's namespace alongside.
  import * as monaco from "monaco-editor/esm/vs/editor/edcore.main.js";
  import "monaco-editor/esm/vs/basic-languages/xml/xml.contribution.js";
  import EditorWorker from "monaco-editor/esm/vs/editor/editor.worker?worker";
  import { buildSchemaModel } from "../../playground/xsd-schema";
  import {
    registerXmlCompletion,
    registerXmlHover,
  } from "../../playground/monaco-xml-schema";
  import { initMonacoTheme } from "../../playground/monaco-theme";
  import schemaSource from "../../playground/thaimusicxml-0.1.xsd?raw";
  import { parse } from "../../../renderer/src/parse.mjs";
  import { layout } from "../../../renderer/src/layout.mjs";
  import { draw } from "../../../renderer/src/draw.mjs";
  import { ready } from "../../../renderer/src/ready.mjs";
  import { defaults } from "../../../renderer/src/settings.mjs";

  // The XML language has no dedicated language-service worker (no json/ts-
  // style smarts to load) - this is only for the generic editor worker Monaco
  // itself uses for things like diffing, so one getWorker covering every
  // label is enough.
  (self as any).MonacoEnvironment = {
    getWorker: () => new EditorWorker(),
  };

  const schema = buildSchemaModel(schemaSource, "thai-score");
  registerXmlCompletion(monaco, schema);
  registerXmlHover(monaco, schema);

  // Only the examples the docs themselves link to (see renderer/HANDOVER.md)
  // - the "-test.txml" fixtures are internal stress tests, not something to
  // hand a first-time visitor.
  const templates = import.meta.glob("../../../renderer/examples/*.txml", {
    query: "?raw",
    import: "default",
    eager: true,
  });
  const templateSource = (file: string) => {
    const entry = Object.entries(templates).find(([path]) =>
      path.endsWith(`/${file}`),
    );
    if (!entry) throw new Error(`playground: no renderer/examples/${file}`);
    return String(entry[1]);
  };

  const editorPane = document.getElementById("editor-pane")!;
  const previewPane = document.getElementById("preview-pane")!;
  const statusEl = document.getElementById("status")!;
  const templateSelect = document.getElementById(
    "template-select",
  ) as HTMLSelectElement;
  const split = document.getElementById("split")!;
  const divider = document.getElementById("divider")!;
  const settingsCommonGrid = document.getElementById("settings-common")!;
  const settingsDetailsGrid = document.getElementById("settings-details")!;
  const settingsAdvancedGrid = document.getElementById("settings-advanced")!;
  const settingsResetButton = document.getElementById(
    "settings-reset",
  ) as HTMLButtonElement;
  const exportTxmlButton = document.getElementById(
    "export-txml",
  ) as HTMLButtonElement;
  const exportSvgButton = document.getElementById(
    "export-svg",
  ) as HTMLButtonElement;
  const exportPngButton = document.getElementById(
    "export-png",
  ) as HTMLButtonElement;
  const exportPdfButton = document.getElementById(
    "export-pdf",
  ) as HTMLButtonElement;
  const importButton = document.getElementById(
    "import-button",
  ) as HTMLButtonElement;
  const importFileInput = document.getElementById(
    "import-file-input",
  ) as HTMLInputElement;
  const saveButton = document.getElementById(
    "save-button",
  ) as HTMLButtonElement;
  const fileStatusEl = document.getElementById("file-status")!;

  // --- Rendering settings panel ---
  //
  // renderer/src/settings.mjs's `defaults` is the single source of truth for
  // every value below - a field never hard-codes its own default, it reads
  // one out of `defaults` via `path`. Two keys are deliberately not exposed
  // here: `measuresPerRow` (its own comment says "Fixed by 'The measure
  // grid'" - normative, not a style choice) and `fontFamily` (draw.mjs
  // embeds actual Sarabun font bytes via @font-face regardless of this
  // string, so a control for it would just mislead).

  type Tier = "common" | "details" | "advanced";
  type FieldType = "checkbox" | "number" | "text" | "color" | "select";

  interface FieldOption {
    value: string;
    label: string;
  }

  interface FieldDef {
    path: string;
    tier: Tier;
    type: FieldType;
    label: string;
    min?: number;
    max?: number;
    step?: number;
    options?: FieldOption[];
    decode?: (raw: string) => unknown;
    encode?: (value: unknown) => string;
    validate?: (value: unknown) => boolean;
  }

  const FIELDS: FieldDef[] = [
    // --- common ---
    {
      path: "pitchSpelling",
      tier: "common",
      type: "select",
      label: "Pitch spelling",
      options: [
        { value: "source", label: "As written" },
        { value: "thai", label: "Thai" },
        { value: "letter", label: "Letter" },
        { value: "number", label: "Number" },
      ],
    },
    {
      // layout.mjs only ever branches on pitchCase === "upper" - there is no
      // implemented "force lowercase" - so this is a checkbox rather than a
      // select offering a choice the renderer doesn't actually have.
      path: "pitchCase",
      tier: "common",
      type: "checkbox",
      label: "Force uppercase pitch letters",
      decode: (raw) => (raw === "true" ? "upper" : "source"),
      encode: (value) => String(value === "upper"),
    },
    {
      path: "printRests",
      tier: "common",
      type: "select",
      label: "Rests",
      options: [
        { value: "all", label: "Print every rest" },
        { value: "none", label: "Hide rests" },
      ],
    },
    {
      path: "generateHeadings",
      tier: "common",
      type: "checkbox",
      label: "Generate section headings",
    },

    // --- details ---
    { path: "restGlyph", tier: "details", type: "text", label: "Rest glyph" },
    {
      path: "showHeaderExtras",
      tier: "details",
      type: "checkbox",
      label: "Show tuning, license, BPM",
    },
    {
      path: "headerExtraSize",
      tier: "details",
      type: "number",
      label: "Header extras size",
      min: 1,
      step: 1,
    },
    {
      path: "showLabels",
      tier: "details",
      type: "select",
      label: "Instrument-name labels",
      options: [
        { value: "auto", label: "Auto (ensemble only)" },
        { value: "true", label: "Always show" },
        { value: "false", label: "Always hide" },
      ],
      decode: (raw) => (raw === "auto" ? null : raw === "true"),
      encode: (value) => (value === null ? "auto" : String(value)),
      validate: (value) => value === null || typeof value === "boolean",
    },
    {
      path: "labelSize",
      tier: "details",
      type: "number",
      label: "Label size",
      min: 1,
      step: 1,
    },
    {
      path: "dimParenthesisDefault",
      tier: "details",
      type: "checkbox",
      label: "Dim cued passages by default",
    },
    {
      // The default "#999" is 3-digit shorthand; <input type="color"> needs
      // 6-digit. Expand it for display only - the stored/default value stays
      // "#999", which is equally valid CSS/SVG.
      path: "dimColor",
      tier: "details",
      type: "color",
      label: "Dim color",
      encode: (value) =>
        typeof value === "string" && value.length === 4
          ? value[0] +
            value[1] +
            value[1] +
            value[2] +
            value[2] +
            value[3] +
            value[3]
          : String(value),
    },
    {
      path: "titleSize",
      tier: "details",
      type: "number",
      label: "Title size",
      min: 1,
      step: 1,
    },
    {
      path: "instrumentNameSize",
      tier: "details",
      type: "number",
      label: "Instrument name size",
      min: 1,
      step: 1,
    },
    {
      path: "creditSize",
      tier: "details",
      type: "number",
      label: "Credit size",
      min: 1,
      step: 1,
    },
    {
      path: "pitchSize",
      tier: "details",
      type: "number",
      label: "Pitch size",
      min: 1,
      step: 1,
    },
    {
      path: "lyricSize",
      tier: "details",
      type: "number",
      label: "Lyric size",
      min: 1,
      step: 1,
    },
    {
      path: "annotationSize",
      tier: "details",
      type: "number",
      label: "Annotation size",
      min: 1,
      step: 1,
    },

    // --- advanced ---
    {
      path: "page.width",
      tier: "advanced",
      type: "number",
      label: "Page width (pt)",
      min: 0,
      step: 1,
    },
    {
      path: "page.height",
      tier: "advanced",
      type: "number",
      label: "Page height (pt, starting value if infinite)",
      min: 0,
      step: 1,
    },
    {
      path: "page.infinite",
      tier: "advanced",
      type: "checkbox",
      label: "Infinite length (no pagination)",
    },
    {
      path: "page.marginSide",
      tier: "advanced",
      type: "number",
      label: "Side margin (pt)",
      min: 0,
      step: 1,
    },
    {
      path: "page.marginTop",
      tier: "advanced",
      type: "number",
      label: "Top margin (pt)",
      min: 0,
      step: 1,
    },
    {
      path: "page.marginBottom",
      tier: "advanced",
      type: "number",
      label: "Bottom margin (pt)",
      min: 0,
      step: 1,
    },
    {
      path: "rowHeight",
      tier: "advanced",
      type: "number",
      label: "Row height",
      min: 0,
      step: 1,
    },
    {
      path: "octaveDotRadius",
      tier: "advanced",
      type: "number",
      label: "Octave dot radius",
      min: 0,
      step: 0.01,
    },
    {
      path: "octaveDotGapAbove",
      tier: "advanced",
      type: "number",
      label: "Octave dot gap above",
      min: 0,
      step: 0.01,
    },
    {
      path: "octaveDotGapBelow",
      tier: "advanced",
      type: "number",
      label: "Octave dot gap below",
      min: 0,
      step: 0.01,
    },
    {
      path: "spread",
      tier: "advanced",
      type: "number",
      label: "Symbol spread",
      min: 0,
      step: 0.01,
    },
    {
      path: "linkTop",
      tier: "advanced",
      type: "number",
      label: "Link curve height",
      min: 0,
      step: 0.01,
    },
    {
      path: "linkSideStep",
      tier: "advanced",
      type: "number",
      label: "Link side step",
      min: 0,
      step: 0.01,
    },
    {
      path: "linkRise",
      tier: "advanced",
      type: "number",
      label: "Link rise",
      min: 0,
      step: 0.01,
    },
    {
      path: "linkStroke",
      tier: "advanced",
      type: "number",
      label: "Link stroke width",
      min: 0,
      step: 0.1,
    },
    {
      path: "groupTightness",
      tier: "advanced",
      type: "number",
      label: "Group tightness",
      min: 0,
      step: 0.01,
    },
    {
      path: "minSymbolAdvance",
      tier: "advanced",
      type: "number",
      label: "Minimum symbol advance",
      min: 0,
      step: 0.01,
    },
    {
      path: "gapScale.0",
      tier: "advanced",
      type: "number",
      label: "Row gap",
      min: 0,
      step: 1,
    },
    {
      path: "gapScale.1",
      tier: "advanced",
      type: "number",
      label: "Instrument gap",
      min: 0,
      step: 1,
    },
    {
      path: "gapScale.2",
      tier: "advanced",
      type: "number",
      label: "Line gap",
      min: 0,
      step: 1,
    },
    {
      path: "gapScale.3",
      tier: "advanced",
      type: "number",
      label: "Section gap",
      min: 0,
      step: 1,
    },
    {
      path: "annotationGap",
      tier: "advanced",
      type: "number",
      label: "Annotation gap",
      min: 0,
      step: 1,
    },
    {
      path: "annotationLeading",
      tier: "advanced",
      type: "number",
      label: "Annotation leading",
      min: 0,
      step: 0.01,
    },
    {
      path: "titleGap",
      tier: "advanced",
      type: "number",
      label: "Title gap",
      min: 0,
      step: 1,
    },
    {
      path: "bandGap",
      tier: "advanced",
      type: "number",
      label: "Band gap",
      min: 0,
      step: 1,
    },
    {
      path: "bowTop",
      tier: "advanced",
      type: "number",
      label: "Bow curve height",
      min: 0,
      step: 0.01,
    },
    {
      path: "bowRise",
      tier: "advanced",
      type: "number",
      label: "Bow rise",
      min: 0,
      step: 0.01,
    },
    {
      path: "bowStroke",
      tier: "advanced",
      type: "number",
      label: "Bow stroke width",
      min: 0,
      step: 0.1,
    },
    {
      path: "bowMinSpan",
      tier: "advanced",
      type: "number",
      label: "Bow minimum span",
      min: 0,
      step: 0.1,
    },
    {
      path: "labelGap",
      tier: "advanced",
      type: "number",
      label: "Label gap",
      min: 0,
      step: 0.01,
    },
    {
      path: "repeatBracketGap",
      tier: "advanced",
      type: "number",
      label: "Repeat bracket gap",
      min: 0,
      step: 0.01,
    },
    {
      path: "repeatBracketDepth",
      tier: "advanced",
      type: "number",
      label: "Repeat bracket depth",
      min: 0,
      step: 0.01,
    },
    {
      path: "repeatBracketStroke",
      tier: "advanced",
      type: "number",
      label: "Repeat bracket stroke width",
      min: 0,
      step: 0.1,
    },
    {
      path: "repeatLabelSize",
      tier: "advanced",
      type: "number",
      label: "Repeat label size",
      min: 1,
      step: 1,
    },
  ];

  function getPath(obj: any, path: string): unknown {
    return path
      .split(".")
      .reduce((o, k) => (o == null ? undefined : o[k]), obj);
  }

  function setPath(obj: any, path: string, value: unknown): void {
    const keys = path.split(".");
    const last = keys.pop()!;
    keys.reduce((o, k) => o[k], obj)[last] = value;
  }

  function defaultValidate(field: FieldDef, value: unknown): boolean {
    switch (field.type) {
      case "checkbox":
        return typeof value === "boolean";
      case "number":
        return typeof value === "number" && Number.isFinite(value);
      case "text":
        return typeof value === "string";
      case "color":
        return typeof value === "string" && /^#[0-9a-f]{6}$/i.test(value);
      case "select":
        // A select with no decode() stores one of its own option values
        // directly. One that decodes (e.g. showLabels) supplies its own
        // field.validate instead of relying on this default.
        return field.options!.some((opt) => opt.value === value);
    }
  }

  const STORAGE_KEY = "thaimusicxml-playground-settings";

  function loadOverrides(): Record<string, unknown> {
    const overrides: Record<string, unknown> = {};
    for (const field of FIELDS)
      overrides[field.path] = getPath(defaults, field.path);

    let saved: unknown;
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) saved = JSON.parse(raw);
    } catch {
      saved = undefined;
    }
    if (saved && typeof saved === "object") {
      for (const field of FIELDS) {
        const value = (saved as Record<string, unknown>)[field.path];
        if (value === undefined) continue;
        const ok = field.validate
          ? field.validate(value)
          : defaultValidate(field, value);
        if (ok) overrides[field.path] = value;
      }
    }
    return overrides;
  }

  function saveOverrides(overrides: Record<string, unknown>): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(overrides));
    } catch {
      // Storage full or unavailable (private browsing) - settings just
      // won't persist; nothing else on the page depends on it.
    }
  }

  function buildOptions(
    overrides: Record<string, unknown>,
  ): Record<string, unknown> {
    // defaults is plain JSON-safe data, so a round-trip is a safe deep clone
    // - layout()/draw() each shallow-merge {...defaults, ...options}, so a
    // partial `page` object or `gapScale` array here would blank out
    // whichever sibling fields the user didn't just touch.
    const options = JSON.parse(JSON.stringify(defaults));
    for (const field of FIELDS)
      setPath(options, field.path, overrides[field.path]);
    return options;
  }

  const overrides = loadOverrides();
  const controlsByPath = new Map<
    string,
    HTMLInputElement | HTMLSelectElement
  >();

  // Appends a label and its control as two direct children of `grid` - not
  // wrapped in a row div - since .settings-grid's two-column template lays
  // out its direct children in label/control pairs, one pair per grid row.
  function buildFieldRow(
    grid: HTMLElement,
    field: FieldDef,
    onChange: () => void,
  ): void {
    const id = `setting-${field.path.replace(/\./g, "-")}`;

    const label = document.createElement("label");
    label.htmlFor = id;
    label.textContent = field.label;
    grid.appendChild(label);

    const current = overrides[field.path];
    let el: HTMLInputElement | HTMLSelectElement;

    if (field.type === "select") {
      const select = document.createElement("select");
      select.id = id;
      for (const opt of field.options!) {
        const o = document.createElement("option");
        o.value = opt.value;
        o.textContent = opt.label;
        select.appendChild(o);
      }
      select.value = field.encode ? field.encode(current) : String(current);
      select.addEventListener("change", () => {
        overrides[field.path] = field.decode
          ? field.decode(select.value)
          : select.value;
        onChange();
      });
      el = select;
    } else {
      const input = document.createElement("input");
      input.id = id;
      input.type = field.type;
      if (field.type === "number") {
        if (field.min !== undefined) input.min = String(field.min);
        if (field.max !== undefined) input.max = String(field.max);
        if (field.step !== undefined) input.step = String(field.step);
      }
      if (field.type === "checkbox") {
        input.checked = Boolean(current);
      } else {
        input.value = field.encode ? field.encode(current) : String(current);
      }
      const eventName = field.type === "checkbox" ? "change" : "input";
      input.addEventListener(eventName, () => {
        overrides[field.path] =
          field.type === "checkbox"
            ? input.checked
            : field.type === "number"
              ? Number(input.value)
              : input.value;
        onChange();
      });
      el = input;
    }

    controlsByPath.set(field.path, el);
    grid.appendChild(el);
  }

  let renderTimer: ReturnType<typeof setTimeout> | undefined;
  const scheduleRender = () => {
    clearTimeout(renderTimer);
    renderTimer = setTimeout(renderPreview, 400);
  };

  const onSettingChange = () => {
    saveOverrides(overrides);
    scheduleRender();
  };
  for (const field of FIELDS.filter((f) => f.tier === "common"))
    buildFieldRow(settingsCommonGrid, field, onSettingChange);
  for (const field of FIELDS.filter((f) => f.tier === "details"))
    buildFieldRow(settingsDetailsGrid, field, onSettingChange);
  for (const field of FIELDS.filter((f) => f.tier === "advanced"))
    buildFieldRow(settingsAdvancedGrid, field, onSettingChange);

  settingsResetButton.addEventListener("click", () => {
    localStorage.removeItem(STORAGE_KEY);
    for (const field of FIELDS) {
      const value = getPath(defaults, field.path);
      overrides[field.path] = value;
      const el = controlsByPath.get(field.path)!;
      if (field.type === "checkbox") {
        (el as HTMLInputElement).checked = Boolean(value);
      } else {
        el.value = field.encode ? field.encode(value) : String(value);
      }
    }
    saveOverrides(overrides);
    scheduleRender();
  });

  // --- File lifecycle: dirty tracking, import, save ---
  //
  // `fileHandle` is a live FileSystemFileHandle where the File System Access
  // API is available (Chromium browsers) and the current buffer came from
  // Import or a prior Save - it is what lets Save write straight back to
  // that file with no download prompt and no second copy on disk. It is
  // null after loading a template (nothing on disk to write back to yet) and
  // on any browser without the API, where every Save is necessarily a fresh
  // download instead.
  let fileHandle: any = null;
  let dirty = false;

  const updateFileStatus = () => {
    const name = fileHandle?.name;
    fileStatusEl.textContent = name
      ? `${dirty ? "● " : ""}${name}`
      : dirty
        ? "● unsaved changes"
        : "";
  };
  const markDirty = () => {
    dirty = true;
    updateFileStatus();
  };
  const markClean = () => {
    dirty = false;
    updateFileStatus();
  };

  // A close/reload with unsaved changes gets the browser's own confirmation
  // prompt - `dirty` is exactly "the buffer differs from what Save last
  // wrote (or what Import/a template last loaded)", so this fires only when
  // there is genuinely something Save would still have to do.
  window.addEventListener("beforeunload", (e) => {
    if (!dirty) return;
    e.preventDefault();
    e.returnValue = "";
  });

  const loadIntoEditor = (text: string) => {
    const model = editor.getModel()!;
    editor.executeEdits("load-template", [
      { range: model.getFullModelRange(), text },
    ]);
  };

  const monoFont =
    getComputedStyle(document.documentElement)
      .getPropertyValue("--__sl-font-mono")
      .trim() || "monospace";

  const editor = monaco.editor.create(editorPane, {
    value: templateSource("example-khaek-borathes.txml"),
    language: "xml",
    automaticLayout: true,
    minimap: { enabled: false },
    // Code folding is not something this playground needs, and its chevron
    // column only adds noise next to the line numbers.
    folding: true,
    fontSize: 13,
    fontFamily: monoFont,
    scrollBeyondLastLine: false,
    // The suggest/hover widgets default to clipping at the editor's own
    // box - this pane's overflow: hidden (see the stylesheet) would clip
    // them the moment a suggestion list runs past the visible bottom edge,
    // so they attach to the document instead.
    fixedOverflowWidgets: true,
  });
  initMonacoTheme(monaco);

  editor.onDidChangeModelContent(() => {
    scheduleRender();
    markDirty();
  });

  templateSelect.addEventListener("change", () => {
    loadIntoEditor(templateSource(templateSelect.value));
    // A template is a fresh start, not an edit to whatever file was open -
    // nothing on disk to fall out of sync with yet.
    fileHandle = null;
    markClean();
  });

  // queryPermission()/requestPermission() are asked for at save time, not
  // right after Import: asking only when a write is actually about to
  // happen is the documented File System Access pattern, and it means a
  // read-only visit (import, look, never save) never prompts at all.
  const canWrite = async (handle: any): Promise<boolean> => {
    const opts = { mode: "readwrite" };
    if ((await handle.queryPermission(opts)) === "granted") return true;
    return (await handle.requestPermission(opts)) === "granted";
  };

  const saveAs = async (content: string) => {
    const handle = await (window as any).showSaveFilePicker({
      suggestedName: `${baseNameFor(content)}.txml`,
      types: [
        {
          description: "ThaiMusicXML",
          accept: { "application/xml": [".txml"] },
        },
      ],
    });
    const writable = await handle.createWritable();
    await writable.write(content);
    await writable.close();
    fileHandle = handle;
  };

  saveButton.addEventListener("click", async () => {
    const content = editor.getValue();
    try {
      if (fileHandle) {
        if (!(await canWrite(fileHandle))) {
          statusEl.textContent =
            "Write permission for this file was not granted.";
          return;
        }
        const writable = await fileHandle.createWritable();
        await writable.write(content);
        await writable.close();
      } else if ("showSaveFilePicker" in window) {
        await saveAs(content);
      } else {
        // No File System Access API at all (Firefox, Safari): the best this
        // platform can do is a plain download, same mechanism as Export >
        // TXML - there is no way to avoid a second copy on disk here.
        const blob = new Blob([content], {
          type: "application/xml;charset=utf-8",
        });
        triggerDownload(blob, `${exportBaseName()}.txml`);
      }
      statusEl.textContent = "";
      markClean();
    } catch (err) {
      // The user closing the save picker without choosing anything is not a
      // failure worth reporting.
      if (err instanceof DOMException && err.name === "AbortError") return;
      statusEl.textContent = err instanceof Error ? err.message : String(err);
    }
  });

  importButton.addEventListener("click", async () => {
    if (!("showOpenFilePicker" in window)) {
      importFileInput.click();
      return;
    }
    try {
      const [handle] = await (window as any).showOpenFilePicker({
        types: [
          {
            description: "ThaiMusicXML",
            accept: { "application/xml": [".txml"] },
          },
        ],
      });
      const text = await (await handle.getFile()).text();
      loadIntoEditor(text);
      fileHandle = handle;
      markClean();
    } catch (err) {
      if (err instanceof DOMException && err.name === "AbortError") return;
      statusEl.textContent = err instanceof Error ? err.message : String(err);
    }
  });

  // The <input type="file"> fallback for browsers with no File System
  // Access API: it can read the picked file but hands back no writable
  // handle, so Save after this always falls through to a plain download.
  importFileInput.addEventListener("change", async () => {
    const file = importFileInput.files?.[0];
    importFileInput.value = "";
    if (!file) return;
    loadIntoEditor(await file.text());
    fileHandle = null;
    markClean();
  });

  // --- Export: TXML, SVG, PNG, PDF ---
  //
  // Each export button acts on the last successfully rendered score, not on
  // whatever is in the editor right now: the two agree except while the
  // editor holds text that fails to parse, and exporting a blank or partial
  // score then would be worse than exporting the last good one. The buttons
  // are disabled instead while that gap exists (see the `catch` branch of
  // renderPreview() below), so "last successful" and "the buttons are even
  // clickable" stay the same condition.
  let lastSource = "";
  let lastWidth = 0;
  let lastHeight = 0;
  let lastSvgs: string[] = [];

  const setExportEnabled = (enabled: boolean) => {
    for (const button of [
      exportTxmlButton,
      exportSvgButton,
      exportPngButton,
      exportPdfButton,
    ])
      button.disabled = !enabled;
  };
  setExportEnabled(false);

  // A source's own <title>, filesystem-safe: strip characters no target
  // platform's filesystem accepts, since a title is free text and Thai
  // scores' titles are not filename-shaped by nature. Falls back to a plain
  // name where the title is empty or entirely made of such characters.
  // `baseNameFor` takes the source directly, for Save (which should reflect
  // whatever the editor holds right now, not the last successful render);
  // `exportBaseName` is that applied to Export's own "last good render"
  // source.
  const baseNameFor = (source: string): string => {
    try {
      const title = parse(source)?.title;
      const safe = String(title ?? "")
        .replace(/[/\\:*?"<>|]/g, " ")
        .trim();
      return safe || "score";
    } catch {
      return "score";
    }
  };
  const exportBaseName = (): string => baseNameFor(lastSource);

  const triggerDownload = (blob: Blob, filename: string) => {
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  };

  // One file per page for SVG/PNG rather than trying to merge several pages
  // into a single image: each page is already its own self-contained,
  // correctly-sized document (draw() embeds the font itself), and a reader
  // opening "score.svg" for a one-page score should not have to guess
  // whether a second page exists.
  const pageFilename = (
    base: string,
    ext: string,
    index: number,
    total: number,
  ) => (total > 1 ? `${base}-p${index + 1}.${ext}` : `${base}.${ext}`);

  exportTxmlButton.addEventListener("click", () => {
    const blob = new Blob([lastSource], {
      type: "application/xml;charset=utf-8",
    });
    triggerDownload(blob, `${exportBaseName()}.txml`);
  });

  exportSvgButton.addEventListener("click", () => {
    const base = exportBaseName();
    lastSvgs.forEach((svg, i) => {
      const blob = new Blob([svg], { type: "image/svg+xml;charset=utf-8" });
      triggerDownload(blob, pageFilename(base, "svg", i, lastSvgs.length));
    });
  });

  // Rasterizes by loading the SVG (already self-contained, font and all) as
  // an <img> and drawing it to a <canvas> - no extra dependency for
  // something a browser already knows how to do. `scale` renders at 2x the
  // page's own point size, since a viewer or printer treating those points
  // as CSS pixels 1:1 would otherwise get a noticeably soft image.
  const svgToPngBlob = (
    svg: string,
    width: number,
    height: number,
    scale = 2,
  ): Promise<Blob> =>
    new Promise((resolve, reject) => {
      const svgUrl = URL.createObjectURL(
        new Blob([svg], { type: "image/svg+xml;charset=utf-8" }),
      );
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(svgUrl);
        const canvas = document.createElement("canvas");
        canvas.width = Math.round(width * scale);
        canvas.height = Math.round(height * scale);
        const ctx = canvas.getContext("2d");
        if (!ctx) return reject(new Error("canvas 2D context unavailable"));
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        canvas.toBlob(
          (blob) =>
            blob ? resolve(blob) : reject(new Error("PNG export failed")),
          "image/png",
        );
      };
      img.onerror = () => {
        URL.revokeObjectURL(svgUrl);
        reject(new Error("could not rasterize the preview SVG"));
      };
      img.src = svgUrl;
    });

  exportPngButton.addEventListener("click", async () => {
    const base = exportBaseName();
    exportPngButton.disabled = true;
    try {
      for (let i = 0; i < lastSvgs.length; i++) {
        const blob = await svgToPngBlob(lastSvgs[i], lastWidth, lastHeight);
        triggerDownload(blob, pageFilename(base, "png", i, lastSvgs.length));
      }
    } catch (err) {
      statusEl.textContent = err instanceof Error ? err.message : String(err);
    } finally {
      exportPngButton.disabled = false;
    }
  });

  // A blank popup holding just the rendered pages, sized to them exactly via
  // @page, then handed to the browser's own print dialog - "Save as PDF"
  // there is the export. Building a PDF directly would mean a bundled
  // library (jsPDF/svg2pdf.js and the bundle weight that brings) just to
  // redo work the browser already does for free; a plain new window (opened
  // synchronously, in direct response to the click, so no popup blocker
  // intervenes) keeps this page's own toolbar and editor out of the printed
  // output without fighting Starlight's site chrome in print media.
  exportPdfButton.addEventListener("click", () => {
    const printWindow = window.open("", "_blank");
    if (!printWindow) {
      statusEl.textContent =
        "Could not open the print window - check your browser's popup blocker.";
      return;
    }
    const title = exportBaseName();
    printWindow.document.write(
      `<!doctype html><html><head><title>${title}</title><style>` +
        `@page { size: ${lastWidth}pt ${lastHeight}pt; margin: 0; }` +
        `html, body { margin: 0; padding: 0; }` +
        `svg { display: block; width: ${lastWidth}pt; height: ${lastHeight}pt; page-break-after: always; }` +
        `svg:last-child { page-break-after: auto; }` +
        `</style></head><body>${lastSvgs.join("")}</body></html>`,
    );
    printWindow.document.close();
    printWindow.onload = () => {
      printWindow.focus();
      printWindow.print();
    };
  });

  function renderPreview() {
    const source = editor.getValue();
    const options = buildOptions(overrides);
    try {
      const laidOut = layout(parse(source), options);
      const svgs = laidOut.pages.map((page: { elements: unknown }) =>
        draw(
          {
            width: laidOut.width,
            height: laidOut.height,
            elements: page.elements,
          },
          options,
        ),
      );
      previewPane.innerHTML = svgs.join("");
      statusEl.textContent = "";
      lastSource = source;
      lastWidth = laidOut.width;
      lastHeight = laidOut.height;
      lastSvgs = svgs;
      setExportEnabled(true);
    } catch (err) {
      statusEl.textContent = err instanceof Error ? err.message : String(err);
      setExportEnabled(false);
    }
  }

  // --- Draggable divider: splits horizontally while the panes sit side by
  // side, vertically once they stack. ---
  let ratio = 0.5;
  const applyRatio = () => {
    (editorPane as HTMLElement).style.flexGrow = String(ratio);
    (previewPane as HTMLElement).style.flexGrow = String(1 - ratio);
  };
  applyRatio();

  // Asking the layout which way it went, rather than re-testing the width
  // here: the switch is a container query now (see the <style> block), and
  // matchMedia cannot express one. Reading the resolved flex-direction also
  // means the drag axis cannot drift from the CSS if the threshold moves.
  const isRow = () => getComputedStyle(split).flexDirection === "row";
  let dragging = false;
  divider.addEventListener("pointerdown", (e) => {
    dragging = true;
    divider.setPointerCapture(e.pointerId);
  });
  divider.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    const rect = split.getBoundingClientRect();
    const pos = isRow()
      ? (e.clientX - rect.left) / rect.width
      : (e.clientY - rect.top) / rect.height;
    ratio = Math.min(0.85, Math.max(0.15, pos));
    applyRatio();
  });
  const stopDrag = (e: PointerEvent) => {
    dragging = false;
    divider.releasePointerCapture(e.pointerId);
  };
  divider.addEventListener("pointerup", stopDrag);
  divider.addEventListener("pointercancel", stopDrag);

  await ready();
  renderPreview();
</script>
