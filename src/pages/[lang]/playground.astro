  // --- The two settings registries, and the machinery both share. Each
  // wraps its own FieldDefs/GroupDefs/Tiers, its own persisted overrides,
  // and its own reaction to a value changing - the renderer schedules its
  // ThaiMusicXML redraw, the converter schedules resolve()+toMusicXml()+
  // toMidi(). Everything below (buildFieldRow, renderNav, renderFields,
  // the reset button) reads through whichever registry is `activeRegistry`
  // rather than a hard-coded one, so the settings overlay works the same
  // way regardless of which source is selected. ---

  interface Registry {
    fields: FieldDef[];
    groups: GroupDef[];
    tiers: Tier[];
    storageKey: string;
    defaultsFor: Record<string, unknown>;
    overrides: Record<string, unknown>;
    activeGroupKey: string;
    onSettingChange: () => void;
  }

  const RENDERER_REGISTRY: Registry = {
    fields: FIELDS,
    groups: GROUPS,
    tiers: TIERS,
    storageKey: STORAGE_KEY,
    defaultsFor: defaults,
    overrides: loadOverrides(FIELDS, STORAGE_KEY, defaults),
    activeGroupKey: "notation",
    onSettingChange: () => {
      saveOverrides(RENDERER_REGISTRY.overrides, RENDERER_REGISTRY.storageKey);
      scheduleRender();
    },
  };

  const CONVERTER_REGISTRY: Registry = {
    fields: CONVERTER_FIELDS,
    groups: CONVERTER_GROUPS,
    tiers: CONVERTER_TIERS,
    storageKey: CONVERTER_STORAGE_KEY,
    defaultsFor: CONVERTER_DEFAULTS,
    overrides: loadOverrides(
      CONVERTER_FIELDS,
      CONVERTER_STORAGE_KEY,
      CONVERTER_DEFAULTS,
    ),
    activeGroupKey: "tuning",
    onSettingChange: () => {
      saveOverrides(
        CONVERTER_REGISTRY.overrides,
        CONVERTER_REGISTRY.storageKey,
      );
      scheduleConverterRender();
    },
  };

  let activeRegistry: Registry = RENDERER_REGISTRY;

  // Appends a label and its control as two direct children of `grid` - not
  // wrapped in a row div - since .settings-grid's two-column template lays
  // out its direct children in label/control pairs, one pair per grid row.
  function buildFieldRow(
    grid: HTMLElement,
    field: FieldDef,
    registry: Registry,
  ): void {
    const id = `setting-${field.path.replace(/\./g, "-")}`;

    const label = document.createElement("label");
    label.htmlFor = id;
    label.textContent = field.label[lang];
    grid.appendChild(label);

    const current = registry.overrides[field.path];
    let el: HTMLInputElement | HTMLSelectElement;

    if (field.type === "select") {
      const select = document.createElement("select");
      select.id = id;
      for (const opt of field.options!) {
        const o = document.createElement("option");
        o.value = opt.value;
        o.textContent = opt.label[lang];
        select.appendChild(o);
      }
      select.value = field.encode ? field.encode(current) : String(current);
      select.addEventListener("change", () => {
        registry.overrides[field.path] = field.decode
          ? field.decode(select.value)
          : select.value;
        registry.onSettingChange();
      });
      el = select;
    } else {
      const input = document.createElement("input");
      input.id = id;
      input.type = field.type;
      if (field.type === "number") {
        if (field.min !== undefined) input.min = String(field.min);
        if (field.max !== undefined) input.max = String(field.max);
        if (field.step !== undefined) input.step = String(field.step);
      }
      if (field.type === "checkbox") {
        input.checked = Boolean(current);
      } else {
        input.value = field.encode ? field.encode(current) : String(current);
      }
      const eventName = field.type === "checkbox" ? "change" : "input";
      input.addEventListener(eventName, () => {
        registry.overrides[field.path] =
          field.type === "checkbox"
            ? input.checked
            : field.type === "number"
              ? Number(input.value)
              : input.value;
        registry.onSettingChange();
      });
      el = input;
    }

    grid.appendChild(el);
  }

  let renderTimer: ReturnType<typeof setTimeout> | undefined;
  const scheduleRender = () => {
    clearTimeout(renderTimer);
    renderTimer = setTimeout(renderPreview, 400);
  };

  let converterRenderTimer: ReturnType<typeof setTimeout> | undefined;
  function scheduleConverterRender(): void {
    clearTimeout(converterRenderTimer);
    converterRenderTimer = setTimeout(convertAndRenderMusicXml, 400);
  }

  // --- Settings overlay: two-level category nav + a single field grid for
  // whichever category is currently selected, instead of one long scrolling
  // list of every field at once. Both registries share this. ---

  function renderFields(): void {
    settingsFieldsGrid.innerHTML = "";
    const group = activeRegistry.groups.find(
      (g) => g.key === activeRegistry.activeGroupKey,
    );
    for (const field of activeRegistry.fields.filter(
      (f) => f.group === activeRegistry.activeGroupKey,
    ))
      buildFieldRow(settingsFieldsGrid, field, activeRegistry);
    group?.renderExtra?.(settingsFieldsGrid);
  }

  function updateNavActiveState(): void {
    for (const button of settingsNav.querySelectorAll("button"))
      button.setAttribute(
        "aria-current",
        String(
          (button as HTMLElement).dataset.group ===
            activeRegistry.activeGroupKey,
        ),
      );
  }

  function selectGroup(key: string): void {
    activeRegistry.activeGroupKey = key;
    renderFields();
    updateNavActiveState();
  }

  function renderNav(): void {
    settingsNav.innerHTML = "";
    for (const tier of activeRegistry.tiers) {
      const tierGroups = activeRegistry.groups.filter((g) => g.tier === tier);
      if (tierGroups.length === 0) continue;
      const heading = document.createElement("div");
      heading.className = "settings-nav-tier";
      heading.textContent = TIER_LABELS[tier][lang];
      settingsNav.appendChild(heading);
      for (const group of tierGroups) {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = group.label[lang];
        button.dataset.group = group.key;
        button.addEventListener("click", () => selectGroup(group.key));
        settingsNav.appendChild(button);
      }
    }
    updateNavActiveState();
  }

  renderNav();
  renderFields();

  settingsResetButton.addEventListener("click", () => {
    localStorage.removeItem(activeRegistry.storageKey);
    for (const field of activeRegistry.fields)
      activeRegistry.overrides[field.path] = getPath(
        activeRegistry.defaultsFor,
        field.path,
      );
    saveOverrides(activeRegistry.overrides, activeRegistry.storageKey);
    renderFields();
    if (activeRegistry === RENDERER_REGISTRY) scheduleRender();
    else scheduleConverterRender();
  });

  function setActiveSettingsSource(registry: Registry, isRenderer: boolean): void {
    activeRegistry = registry;
    settingsSourceRendererButton.setAttribute(
      "aria-pressed",
      String(isRenderer),
    );
    settingsSourceConverterButton.setAttribute(
      "aria-pressed",
      String(!isRenderer),
    );
    renderNav();
    renderFields();
  }

  settingsSourceRendererButton.addEventListener("click", () =>
    setActiveSettingsSource(RENDERER_REGISTRY, true),
  );
  settingsSourceConverterButton.addEventListener("click", () =>
    setActiveSettingsSource(CONVERTER_REGISTRY, false),
  );

  function setSettingsOpen(open: boolean): void {
    settingsOverlay.hidden = !open;
    settingsToggleButton.setAttribute("aria-expanded", String(open));
  }

  settingsToggleButton.addEventListener("click", () =>
    setSettingsOpen(settingsOverlay.hidden),
  );
  settingsCloseButton.addEventListener("click", () => setSettingsOpen(false));

  // Native <details> doesn't close itself on an outside click - this menu
  // should behave like a normal desktop menu bar, so it gets that behavior
  // explicitly. The second listener closes it after a format is actually
  // chosen, so picking SVG/PNG/PDF both triggers the download and dismisses
  // the menu in one click.
  document.addEventListener("click", (e) => {
    if (exportDetails.open && !exportDetails.contains(e.target as Node))
      exportDetails.removeAttribute("open");
  });
  exportPanel.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "BUTTON")
      exportDetails.removeAttribute("open");
  });

  // --- File lifecycle: dirty tracking, import, save, save as ---
  //
  // `fileHandle` is a live FileSystemFileHandle where the File System Access
  // API is available (Chromium browsers) and the current buffer came from
  // Import or a prior Save/Save As - it is what lets Save write straight
  // back to that file with no download prompt and no second copy on disk.
  // It is null after loading a template (nothing on disk to write back to
  // yet) and on any browser without the API, where every Save is
  // necessarily a fresh download instead.
  let fileHandle: any = null;
  let dirty = false;

  const updateFileStatus = () => {
    const name = fileHandle?.name;
    fileStatusEl.textContent = name
      ? `${dirty ? "● " : ""}${name}`
      : dirty
        ? t({ en: "● unsaved changes", th: "● มีการแก้ไขที่ยังไม่ได้บันทึก" })
        : "";
  };
  const markDirty = () => {
    dirty = true;
    updateFileStatus();
  };
  const markClean = () => {
    dirty = false;
    updateFileStatus();
  };

  // A close/reload with unsaved changes gets the browser's own confirmation
  // prompt - `dirty` is exactly "the buffer differs from what Save last
  // wrote (or what Import/a template last loaded)", so this fires only when
  // there is genuinely something Save would still have to do.
  window.addEventListener("beforeunload", (e) => {
    if (!dirty) return;
    e.preventDefault();
    e.returnValue = "";
  });

  const loadIntoEditor = (text: string) => {
    const model = editor.getModel()!;
    editor.executeEdits("load-template", [
      { range: model.getFullModelRange(), text },
    ]);
  };

  const monoFont =
    getComputedStyle(document.documentElement)
      .getPropertyValue("--__sl-font-mono")
      .trim() || "monospace";

  const editor = monaco.editor.create(editorPane, {
    value: templateSource("example-lao-duang-duean.txml"),
    language: "xml",
    automaticLayout: true,
    minimap: { enabled: false },
    // Code folding is not something this playground needs, and its chevron
    // column only adds noise next to the line numbers.
    folding: true,
    fontSize: 13,
    fontFamily: monoFont,
    scrollBeyondLastLine: false,
    // The suggest/hover widgets default to clipping at the editor's own
    // box - this pane's overflow: hidden (see the stylesheet) would clip
    // them the moment a suggestion list runs past the visible bottom edge,
    // so they attach to the document instead.
    fixedOverflowWidgets: true,
  });
  initMonacoTheme(monaco);

  editor.onDidChangeModelContent(() => {
    scheduleRender();
    scheduleConverterRender();
    markDirty();
  });

  templateSelect.addEventListener("change", () => {
    loadIntoEditor(templateSource(templateSelect.value));
    // A template is a fresh start, not an edit to whatever file was open -
    // nothing on disk to fall out of sync with yet.
    fileHandle = null;
    markClean();
  });

  // queryPermission()/requestPermission() are asked for at save time, not
  // right after Import: asking only when a write is actually about to
  // happen is the documented File System Access pattern, and it means a
  // read-only visit (import, look, never save) never prompts at all.
  const canWrite = async (handle: any): Promise<boolean> => {
    const opts = { mode: "readwrite" };
    if ((await handle.queryPermission(opts)) === "granted") return true;
    return (await handle.requestPermission(opts)) === "granted";
  };

  const saveAs = async (content: string) => {
    const handle = await (window as any).showSaveFilePicker({
      suggestedName: `${baseNameFor(content)}.txml`,
      types: [
        {
          description: "ThaiMusicXML",
          accept: { "application/xml": [".txml"] },
        },
      ],
    });
    const writable = await handle.createWritable();
    await writable.write(content);
    await writable.close();
    fileHandle = handle;
  };

  // Save and Save As share this: with no file open yet they behave
  // identically (both prompt for a new file, or fall back to a plain
  // download where the File System Access API doesn't exist). Once a file
  // is open, Save writes straight back to it; Save As (forceNew) always
  // re-prompts and switches the current target to whatever the user picks,
  // same as Save As in any desktop editor.
  const performSave = async (forceNew: boolean): Promise<void> => {
    const content = editor.getValue();
    try {
      if (fileHandle && !forceNew) {
        if (!(await canWrite(fileHandle))) {
          statusEl.textContent = t({
            en: "Write permission for this file was not granted.",
            th: "ไม่ได้รับสิทธิ์เขียนไฟล์นี้",
          });
          return;
        }
        const writable = await fileHandle.createWritable();
        await writable.write(content);
        await writable.close();
      } else if ("showSaveFilePicker" in window) {
        await saveAs(content);
      } else {
        // No File System Access API at all (Firefox, Safari): the best this
        // platform can do is a plain download, same mechanism as Export -
        // there is no way to avoid a second copy on disk here.
        const blob = new Blob([content], {
          type: "application/xml;charset=utf-8",
        });
        triggerDownload(blob, `${exportBaseName()}.txml`);
      }
      statusEl.textContent = "";
      markClean();
    } catch (err) {
      // The user closing the save picker without choosing anything is not a
      // failure worth reporting.
      if (err instanceof DOMException && err.name === "AbortError") return;
      statusEl.textContent = err instanceof Error ? err.message : String(err);
    }
  };

  saveButton.addEventListener("click", () => performSave(false));
  saveAsButton.addEventListener("click", () => performSave(true));

  importButton.addEventListener("click", async () => {
    if (!("showOpenFilePicker" in window)) {
      importFileInput.click();
      return;
    }
    try {
      const [handle] = await (window as any).showOpenFilePicker({
        types: [
          {
            description: "ThaiMusicXML",
            accept: { "application/xml": [".txml"] },
          },
        ],
      });
      const text = await (await handle.getFile()).text();
      loadIntoEditor(text);
      fileHandle = handle;
      markClean();
    } catch (err) {
      if (err instanceof DOMException && err.name === "AbortError") return;
      statusEl.textContent = err instanceof Error ? err.message : String(err);
    }
  });

  // The <input type="file"> fallback for browsers with no File System
  // Access API: it can read the picked file but hands back no writable
  // handle, so Save after this always falls through to a plain download.
  importFileInput.addEventListener("change", async () => {
    const file = importFileInput.files?.[0];
    importFileInput.value = "";
    if (!file) return;
    loadIntoEditor(await file.text());
    fileHandle = null;
    markClean();
  });

  // --- Export: SVG, PNG, PDF ---
  //
  // Each export button acts on the last successfully rendered score, not on
  // whatever is in the editor right now: the two agree except while the
  // editor holds text that fails to parse, and exporting a blank or partial
  // score then would be worse than exporting the last good one. The buttons
  // are disabled instead while that gap exists (see the `catch` branch of
  // renderPreview() below), so "last successful" and "the buttons are even
  // clickable" stay the same condition.
  let lastSource = "";
  let lastWidth = 0;
  let lastHeight = 0;
  let lastSvgs: string[] = [];
  // Which `lastSvgs` reference was last actually committed to
  // thaimusicxmlView's DOM - compared by identity, not content, so a
  // no-op re-render (same array instance) never re-triggers a repaint.
  let paintedSvgs: string[] | null = null;

  // The converter pipeline's own equivalents, populated by
  // convertAndRenderMusicXml() below - independent of the renderer's, since
  // the two pipelines succeed or fail on their own.
  let lastMusicXml: string | null = null;
  let lastMidiBytes: Uint8Array | null = null;
  let lastResolvedDoc: any = null;

  const setRendererExportEnabled = (enabled: boolean) => {
    for (const button of [exportSvgButton, exportPngButton, exportPdfButton])
      button.disabled = !enabled;
  };
  const setConverterExportEnabled = (enabled: boolean) => {
    for (const button of [exportMusicXmlButton, exportMidiButton])
      button.disabled = !enabled;
  };
  setRendererExportEnabled(false);
  setConverterExportEnabled(false);

  // Which view is showing, and each pipeline's own last error (or null on
  // success) - #status is shared between the two pipelines, so it always
  // shows whichever one belongs to the currently active view, both right
  // after that pipeline runs and when the user switches views.
  type ViewName = "thaimusicxml" | "musicxml";
  let currentView: ViewName = "thaimusicxml";
  let rendererError: string | null = null;
  let converterError: string | null = null;

  // A source's own <title>, filesystem-safe: strip characters no target
  // platform's filesystem accepts, since a title is free text and Thai
  // scores' titles are not filename-shaped by nature. Falls back to a plain
  // name where the title is empty or entirely made of such characters.
  const baseNameFor = (source: string): string => {
    try {
      const title = parse(source)?.title;
      const safe = String(title ?? "")
        .replace(/[/\\:*?"<>|]/g, " ")
        .trim();
      return safe || "score";
    } catch {
      return "score";
    }
  };
  const exportBaseName = (): string => baseNameFor(lastSource);

  const triggerDownload = (blob: Blob, filename: string) => {
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  };

  // One file per page for SVG/PNG rather than trying to merge several pages
  // into a single image: each page is already its own self-contained,
  // correctly-sized document (draw() embeds the font itself), and a reader
  // opening "score.svg" for a one-page score should not have to guess
  // whether a second page exists.
  const pageFilename = (
    base: string,
    ext: string,
    index: number,
    total: number,
  ) => (total > 1 ? `${base}-p${index + 1}.${ext}` : `${base}.${ext}`);

  exportSvgButton.addEventListener("click", () => {
    const base = exportBaseName();
    lastSvgs.forEach((svg, i) => {
      const blob = new Blob([svg], { type: "image/svg+xml;charset=utf-8" });
      triggerDownload(blob, pageFilename(base, "svg", i, lastSvgs.length));
    });
  });

  // Rasterizes by loading the SVG (already self-contained, font and all) as
  // an <img> and drawing it to a <canvas> - no extra dependency for
  // something a browser already knows how to do. `scale` renders at 2x the
  // page's own point size, since a viewer or printer treating those points
  // as CSS pixels 1:1 would otherwise get a noticeably soft image.
  const svgToPngBlob = (
    svg: string,
    width: number,
    height: number,
    scale = 2,
  ): Promise<Blob> =>
    new Promise((resolve, reject) => {
      const svgUrl = URL.createObjectURL(
        new Blob([svg], { type: "image/svg+xml;charset=utf-8" }),
      );
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(svgUrl);
        const canvas = document.createElement("canvas");
        canvas.width = Math.round(width * scale);
        canvas.height = Math.round(height * scale);
        const ctx = canvas.getContext("2d");
        if (!ctx) return reject(new Error("canvas 2D context unavailable"));
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        canvas.toBlob(
          (blob) =>
            blob ? resolve(blob) : reject(new Error("PNG export failed")),
          "image/png",
        );
      };
      img.onerror = () => {
        URL.revokeObjectURL(svgUrl);
        reject(new Error("could not rasterize the preview SVG"));
      };
      img.src = svgUrl;
    });

  exportPngButton.addEventListener("click", async () => {
    const base = exportBaseName();
    exportPngButton.disabled = true;
    try {
      for (let i = 0; i < lastSvgs.length; i++) {
        const blob = await svgToPngBlob(lastSvgs[i], lastWidth, lastHeight);
        triggerDownload(blob, pageFilename(base, "png", i, lastSvgs.length));
      }
    } catch (err) {
      statusEl.textContent = err instanceof Error ? err.message : String(err);
    } finally {
      exportPngButton.disabled = false;
    }
  });

  // A blank popup holding just the rendered pages, sized to them exactly via
  // @page, then handed to the browser's own print dialog - "Save as PDF"
  // there is the export. Building a PDF directly would mean a bundled
  // library (jsPDF/svg2pdf.js and the bundle weight that brings) just to
  // redo work the browser already does for free; a plain new window (opened
  // synchronously, in direct response to the click, so no popup blocker
  // intervenes) keeps this page's own toolbar and editor out of the printed
  // output without fighting Starlight's site chrome in print media.
  exportPdfButton.addEventListener("click", () => {
    const printWindow = window.open("", "_blank");
    if (!printWindow) {
      statusEl.textContent = t({
        en: "Could not open the print window - check your browser's popup blocker.",
        th: "เปิดหน้าต่างพิมพ์ไม่ได้ - โปรดตรวจสอบตัวบล็อกป๊อปอัปของเบราว์เซอร์",
      });
      return;
    }
    const title = exportBaseName();
    printWindow.document.write(
      `<!doctype html><html><head><title>${title}</title><style>` +
        `@page { size: ${lastWidth}pt ${lastHeight}pt; margin: 0; }` +
        `html, body { margin: 0; padding: 0; }` +
        `svg { display: block; width: ${lastWidth}pt; height: ${lastHeight}pt; page-break-after: always; }` +
        `svg:last-child { page-break-after: auto; }` +
        `</style></head><body>${lastSvgs.join("")}</body></html>`,
    );
    printWindow.document.close();
    printWindow.onload = () => {
      printWindow.focus();
      printWindow.print();
    };
  });

  // Commits the last-computed SVGs to thaimusicxmlView's DOM - the one part
  // of the ThaiMusicXML pipeline actually worth gating behind currentView,
  // since building the SVG strings in renderPreview() below is cheap (no
  // DOM), but committing hundreds of nodes via innerHTML while that view
  // isn't even visible is pure waste. Called both right after a successful
  // renderPreview() (a no-op there if the other view is showing) and when
  // switching into this view (a no-op there if already painted).
  function paintThaiMusicXmlIfNeeded(): void {
    if (currentView !== "thaimusicxml") return;
    if (paintedSvgs === lastSvgs) return;
    thaimusicxmlView.innerHTML = lastSvgs.join("");
    paintedSvgs = lastSvgs;
  }

  function renderPreview() {
    const source = editor.getValue();
    const options = buildOptions(RENDERER_REGISTRY.overrides);
    try {
      const laidOut = layout(parse(source), options);
      const svgs = laidOut.pages.map((page: { elements: unknown }) =>
        draw(
          {
            width: laidOut.width,
            height: laidOut.height,
            elements: page.elements,
          },
          options,
        ),
      );
      rendererError = null;
      if (currentView === "thaimusicxml") statusEl.textContent = "";
      lastSource = source;
      lastWidth = laidOut.width;
      lastHeight = laidOut.height;
      lastSvgs = svgs;
      paintThaiMusicXmlIfNeeded();
      setRendererExportEnabled(true);
    } catch (err) {
      rendererError = err instanceof Error ? err.message : String(err);
      if (currentView === "thaimusicxml") statusEl.textContent = rendererError;
      setRendererExportEnabled(false);
    }
  }

  // --- Warnings: non-fatal messages from toMusicXml()/toMidi()'s warn()
  // callbacks (a dropped lyric part, a tuning fallback...), sharing
  // #status-bar's one row with #status, which stays reserved for a fatal
  // error from either pipeline - the bar itself collapses to nothing when
  // both are empty (see .status-bar's :has() rule), so a clean render costs
  // no vertical space.
  //
  // Grouped by which converter target produced each message, under its own
  // heading, rather than merged into one flat list: toMusicXml() and
  // toMidi() each walk the same resolved document and flag the same
  // underlying data problem independently (a note whose sound/pitch
  // mismatches its part's declared type, say), in their own wording - a
  // merged list reads as if the converter glitched and repeated itself,
  // when really it's two different exports agreeing there's a problem. ---
  interface WarningGroup {
    label: string;
    warnings: string[];
  }

  function renderWarnings(groups: WarningGroup[]): void {
    warningsList.innerHTML = "";
    let total = 0;
    for (const { label, warnings } of groups) {
      if (warnings.length === 0) continue;
      total += warnings.length;
      const heading = document.createElement("li");
      heading.className = "warnings-group-label";
      heading.textContent = label;
      warningsList.appendChild(heading);
      for (const w of warnings) {
        const li = document.createElement("li");
        li.textContent = w;
        warningsList.appendChild(li);
      }
    }
    warningsToggle.hidden = total === 0;
    if (total === 0) {
      statusBar.classList.remove("open");
      return;
    }
    warningsToggle.textContent = `${total} ${t(
      total === 1 ? { en: "warning", th: "คำเตือน" } : { en: "warnings", th: "คำเตือน" },
    )} ▾`;
  }

  warningsToggle.addEventListener("click", () => {
    const open = statusBar.classList.toggle("open");
    warningsToggle.setAttribute("aria-expanded", String(open));
  });

  // --- Converter pipeline: resolve() -> toMusicXml()/toMidi(), independent
  // of and parallel to the ThaiMusicXML renderer above. lyricsMap/
  // instrumentMap/percussionMap are built fresh from the current document
  // and the user's persisted per-item choices every run - see
  // buildLyricsMap/buildInstrumentMap/buildPercussionMap and
  // renderLyricsMapRows/renderMidiMapRows further up for the UI side of the
  // same data. ---

  // Once the lyricsMap UI exists, resolveLyricPairs' own semantics (a
  // supplied lyricsMap fully replaces the default pairing, not adds to it)
  // mean this always has to be passed explicitly - never undefined - or the
  // UI and the actual export would silently diverge.
  function buildLyricsMap(doc: any, groups: any[]): Record<string, string> {
    const lyricParts = doc.parts.filter((p: any) => p.type === "lyric");
    const map: Record<string, string> = {};
    lyricParts.forEach((p: any, i: number) => {
      const choice = currentLyricChoice(groups, p.id, i);
      if (choice !== "drop") map[p.id] = choice;
    });
    return map;
  }

  // Sparse, unlike lyricsMap: only a non-"auto" row is included, so an
  // unmapped name/code still falls through to to-midi.mjs's own built-in
  // table/auto-cycle, matching its existing "overrides checked first, table
  // otherwise" semantics.
  function buildInstrumentMap(pitchedGroups: any[]): Record<string, number> {
    const map: Record<string, number> = {};
    const seen = new Set<string>();
    for (const g of pitchedGroups) {
      const name = g.members[0].name;
      if (seen.has(name)) continue;
      seen.add(name);
      const choice = instrumentMapChoices[name];
      if (choice !== undefined && choice !== "auto") map[name] = Number(choice);
    }
    return map;
  }

  function buildPercussionMap(doc: any, unpitchedGroups: any[]): Record<string, number> {
    const map: Record<string, number> = {};
    const seen = new Set<string>();
    for (const g of unpitchedGroups) {
      for (const member of g.members) {
        for (const note of doc.unroll(member.id).notes) {
          if (note.rest || note.sound == null || seen.has(note.sound)) continue;
          seen.add(note.sound);
          const choice = percussionMapChoices[note.sound];
          if (choice !== undefined && choice !== "auto") map[note.sound] = Number(choice);
        }
      }
    }
    return map;
  }

  // Drops a persisted choice once its key (a lyric part id, instrument
  // name, or sound code) no longer appears in the current document, so
  // storage doesn't grow unbounded across edits.
  function pruneConverterMapChoices(
    doc: any,
    pitchedGroups: any[],
    unpitchedGroups: any[],
  ): void {
    const lyricIds = new Set(
      doc.parts.filter((p: any) => p.type === "lyric").map((p: any) => p.id),
    );
    for (const key of Object.keys(lyricsMapChoices))
      if (!lyricIds.has(key)) delete lyricsMapChoices[key];

    const instrumentNames = new Set(pitchedGroups.map((g) => g.members[0].name));
    for (const key of Object.keys(instrumentMapChoices))
      if (!instrumentNames.has(key)) delete instrumentMapChoices[key];

    const soundCodes = new Set<string>();
    for (const g of unpitchedGroups)
      for (const m of g.members)
        for (const n of doc.unroll(m.id).notes)
          if (!n.rest && n.sound != null) soundCodes.add(n.sound);
    for (const key of Object.keys(percussionMapChoices))
      if (!soundCodes.has(key)) delete percussionMapChoices[key];

    saveConverterMaps();
  }

  // Re-renders the settings grid only when a converter mapping group is the
  // one currently open, so a source edit or a splitStacks toggle rebuilds
  // the lyricsMap/instrumentMap/percussionMap row lists (not just their
  // selected values) without the settings overlay even needing to be open.
  function refreshDynamicConverterRowsIfVisible(): void {
    if (activeRegistry !== CONVERTER_REGISTRY) return;
    if (
      activeRegistry.activeGroupKey === "lyrics" ||
      activeRegistry.activeGroupKey === "midi"
    )
      renderFields();
  }

  function convertAndRenderMusicXml(): void {
    const source = editor.getValue();
    const mxmlWarnings: string[] = [];
    const midiWarnings: string[] = [];
    try {
      const doc = resolve(source);
      const tuningOverride = CONVERTER_REGISTRY.overrides.tuning;
      const tuning =
        tuningOverride === "auto" ? undefined : (tuningOverride as string);
      const splitStacks = Boolean(CONVERTER_REGISTRY.overrides.splitStacks);
      const lyricsEnabled = Boolean(CONVERTER_REGISTRY.overrides.lyrics);

      const notatedGroups = groupParts(
        doc.parts.filter((p: any) => p.type !== "lyric"),
        splitStacks,
      );
      const pitchedGroups = notatedGroups.filter(
        (g: any) => g.members[0].type !== "unpitched",
      );
      const unpitchedGroups = notatedGroups.filter(
        (g: any) => g.members[0].type === "unpitched",
      );
      pruneConverterMapChoices(doc, pitchedGroups, unpitchedGroups);

      const lyricsMap = buildLyricsMap(doc, notatedGroups);
      const instrumentMap = buildInstrumentMap(pitchedGroups);
      const percussionMap = buildPercussionMap(doc, unpitchedGroups);

      const xml = toMusicXml(doc, {
        tuning,
        splitStacks,
        downbeatShift: Boolean(CONVERTER_REGISTRY.overrides.downbeatShift),
        trimLeadingEmptyMeasures: Boolean(
          CONVERTER_REGISTRY.overrides.trimLeadingEmptyMeasures,
        ),
        lyrics: lyricsEnabled,
        lyricsMap,
        warn: (m: string) => mxmlWarnings.push(m),
      });
      const midi = toMidi(doc, {
        tuning,
        splitStacks,
        instrumentMap,
        percussionMap,
        warn: (m: string) => midiWarnings.push(m),
      });

      lastMusicXml = xml;
      lastMidiBytes = midi;
      lastResolvedDoc = doc;
      converterError = null;
      if (currentView === "musicxml") statusEl.textContent = "";
      setConverterExportEnabled(true);
      renderWarnings([
        { label: "MusicXML", warnings: mxmlWarnings },
        { label: "MIDI", warnings: midiWarnings },
      ]);
      refreshDynamicConverterRowsIfVisible();
      if (currentView === "musicxml") void renderMusicXmlView();
    } catch (err) {
      lastMusicXml = null;
      lastMidiBytes = null;
      lastResolvedDoc = null;
      converterError = err instanceof Error ? err.message : String(err);
      if (currentView === "musicxml") statusEl.textContent = converterError;
      setConverterExportEnabled(false);
      renderWarnings([]);
    }
  }

  // --- MusicXML view: OpenSheetMusicDisplay, dynamically imported the first
  // time it's actually needed - it pulls in a multi-MB dependency tree most
  // playground visits (anyone just looking at the ThaiMusicXML render)
  // never touch.
  //
  // Rendered inside #musicxml-frame, a real <iframe>, not directly in this
  // document. Measured directly (Monaco's own render(true) timed before/
  // after, 30-40 calls averaged): with OSMD's SVG - tens of thousands of
  // path/text nodes for a real score - living in the main document, every
  // Monaco render while this view was open cost ~155ms versus ~16ms
  // normally, a 60fps editor dropping to roughly 6fps. CSS containment
  // (contain: layout/style/paint, even contain: strict) measured zero
  // improvement. Moving the exact same OSMD instance into an iframe measured
  // back at ~9ms - a real document boundary isolates layout/style/paint/
  // hit-testing in a way same-document containment doesn't, at least for
  // content this SVG-heavy. ---
  let osmdModulePromise: Promise<typeof import("opensheetmusicdisplay")> | null =
    null;
  function loadOsmd() {
    osmdModulePromise ??= import("opensheetmusicdisplay");
    return osmdModulePromise;
  }

  // The iframe has no src/srcdoc, so it's already "complete" (about:blank)
  // by the time this normally runs - this only matters for the rare case
  // where it isn't yet.
  function waitForMusicxmlFrame(): Promise<void> {
    return new Promise((resolve) => {
      if (musicxmlFrame.contentDocument?.readyState === "complete") {
        resolve();
        return;
      }
      musicxmlFrame.addEventListener("load", () => resolve(), { once: true });
    });
  }

  // The iframe has no intrinsic height (empty document, no CSS of its own) -
  // sized to its actual rendered content after every render, so
  // #preview-pane's own scrollbar keeps covering the whole score instead of
  // the iframe growing a second, nested one.
  function syncMusicxmlFrameHeight(): void {
    const doc = musicxmlFrame.contentDocument;
    if (!doc?.documentElement) return;
    musicxmlFrame.style.height = `${doc.documentElement.scrollHeight}px`;
  }

  let osmd: OSMDType | null = null;
  let osmdRenderToken = 0;
  let osmdRenderedXml: string | null = null;
  let osmdResizeTimer: ReturnType<typeof setTimeout> | undefined;

  async function renderMusicXmlView(): Promise<void> {
    if (lastMusicXml === null) return;
    if (osmd && osmdRenderedXml === lastMusicXml) return;
    const token = ++osmdRenderToken;
    const xml = lastMusicXml;
    try {
      const { OpenSheetMusicDisplay } = await loadOsmd();
      if (token !== osmdRenderToken) return; // a newer render started meanwhile
      if (!osmd) {
        await waitForMusicxmlFrame();
        if (token !== osmdRenderToken) return;
        const frameDoc = musicxmlFrame.contentDocument!;
        frameDoc.body.style.margin = "0";
        frameDoc.body.style.background = "#fff";
        const container = frameDoc.createElement("div");
        frameDoc.body.appendChild(container);
        osmd = new OpenSheetMusicDisplay(container, {
          autoResize: false,
          drawTitle: true,
        });
        // autoResize's own ResizeObserver re-renders - rebuilding this
        // view's thousands of SVG nodes from scratch - on every tick with
        // no throttling. Driving resize ourselves, coalesced to one
        // re-render per pause, avoids that; observing the iframe's own box
        // from this document works fine across the frame boundary.
        const instance = osmd;
        new ResizeObserver(() => {
          if (osmdRenderedXml === null) return;
          clearTimeout(osmdResizeTimer);
          osmdResizeTimer = setTimeout(() => {
            if (currentView === "musicxml") {
              instance.render();
              syncMusicxmlFrameHeight();
            }
          }, 300);
        }).observe(musicxmlFrame);
      }
      await osmd.load(xml);
      if (token !== osmdRenderToken) return;
      // load() resets zoom to 1 internally, so this has to happen after it,
      // not before - the engraving defaults otherwise read as a full-size
      // printed part, way too large for a preview pane. Half size fits far
      // more of the score at once.
      osmd.zoom = 0.5;
      osmd.render();
      syncMusicxmlFrameHeight();
      osmdRenderedXml = xml;
    } catch (err) {
      if (token !== osmdRenderToken) return;
      converterError = err instanceof Error ? err.message : String(err);
      if (currentView === "musicxml") statusEl.textContent = converterError;
    }
  }

  function setActiveView(view: ViewName): void {
    currentView = view;
    thaimusicxmlView.hidden = view !== "thaimusicxml";
    musicxmlView.hidden = view !== "musicxml";
    paintThaiMusicXmlIfNeeded();
    viewThaiMusicXmlButton.setAttribute(
      "aria-pressed",
      String(view === "thaimusicxml"),
    );
    viewMusicXmlButton.setAttribute(
      "aria-pressed",
      String(view === "musicxml"),
    );
    exportPanel.dataset.activeView = view;
    statusEl.textContent =
      (view === "thaimusicxml" ? rendererError : converterError) ?? "";
    if (view === "musicxml") void renderMusicXmlView();
  }

  viewThaiMusicXmlButton.addEventListener("click", () =>
    setActiveView("thaimusicxml"),
  );
  viewMusicXmlButton.addEventListener("click", () => setActiveView("musicxml"));

  exportMusicXmlButton.addEventListener("click", () => {
    if (!lastMusicXml) return;
    const blob = new Blob([lastMusicXml], {
      type: "application/vnd.recordare.musicxml+xml",
    });
    triggerDownload(blob, `${exportBaseName()}.musicxml`);
  });

  exportMidiButton.addEventListener("click", () => {
    if (!lastMidiBytes) return;
    const blob = new Blob([lastMidiBytes], { type: "audio/midi" });
    triggerDownload(blob, `${exportBaseName()}.mid`);
  });

  // --- Draggable divider: splits horizontally while the panes sit side by
  // side, vertically once they stack. ---
  let ratio = 0.5;
  const applyRatio = () => {
    (editorPane as HTMLElement).style.flexGrow = String(ratio);
    (previewPane as HTMLElement).style.flexGrow = String(1 - ratio);
  };
  applyRatio();

  // Asking the layout which way it went, rather than re-testing the width
  // here: the switch is a container query now (see the <style> block), and
  // matchMedia cannot express one. Reading the resolved flex-direction also
  // means the drag axis cannot drift from the CSS if the threshold moves.
  const isRow = () => getComputedStyle(split).flexDirection === "row";
  let dragging = false;
  divider.addEventListener("pointerdown", (e) => {
    dragging = true;
    divider.setPointerCapture(e.pointerId);
  });
  divider.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    const rect = split.getBoundingClientRect();
    const pos = isRow()
      ? (e.clientX - rect.left) / rect.width
      : (e.clientY - rect.top) / rect.height;
    ratio = Math.min(0.85, Math.max(0.15, pos));
    applyRatio();
  });
  const stopDrag = (e: PointerEvent) => {
    dragging = false;
    divider.releasePointerCapture(e.pointerId);
  };
  divider.addEventListener("pointerup", stopDrag);
  divider.addEventListener("pointercancel", stopDrag);

  setActiveView("thaimusicxml");

  await ready();
  renderPreview();
  convertAndRenderMusicXml();
</script>
