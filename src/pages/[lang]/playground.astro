  // buildLyricsMap/buildInstrumentMap/buildPercussionMap.
  let lyricsMapChoices: Record<string, string> = {};
  let instrumentMapChoices: Record<string, string> = {};
  let percussionMapChoices: Record<string, string> = {};

  function loadConverterMaps(): void {
    try {
      const raw = localStorage.getItem(CONVERTER_MAPS_STORAGE_KEY);
      if (!raw) return;
      const saved = JSON.parse(raw);
      if (saved && typeof saved === "object") {
        lyricsMapChoices = saved.lyricsMapChoices ?? {};
        instrumentMapChoices = saved.instrumentMapChoices ?? {};
        percussionMapChoices = saved.percussionMapChoices ?? {};
      }
    } catch {
      // Corrupt or unavailable storage - start from empty maps.
    }
  }

  function saveConverterMaps(): void {
    try {
      localStorage.setItem(
        CONVERTER_MAPS_STORAGE_KEY,
        JSON.stringify({
          lyricsMapChoices,
          instrumentMapChoices,
          percussionMapChoices,
        }),
      );
    } catch {
      // Storage full or unavailable - just won't persist.
    }
  }

  loadConverterMaps();

