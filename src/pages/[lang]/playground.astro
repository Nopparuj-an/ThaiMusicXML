  function getPath(obj: any, path: string): unknown {
    return path
      .split(".")
      .reduce((o, k) => (o == null ? undefined : o[k]), obj);
  }

  function setPath(obj: any, path: string, value: unknown): void {
    const keys = path.split(".");
    const last = keys.pop()!;
    keys.reduce((o, k) => o[k], obj)[last] = value;
  }

  function defaultValidate(field: FieldDef, value: unknown): boolean {
    switch (field.type) {
      case "checkbox":
        return typeof value === "boolean";
      case "number":
        return typeof value === "number" && Number.isFinite(value);
      case "text":
        return typeof value === "string";
      case "color":
        return typeof value === "string" && /^#[0-9a-f]{6}$/i.test(value);
      case "select":
        // A select with no decode() stores one of its own option values
        // directly. One that decodes (e.g. showLabels) supplies its own
        // field.validate instead of relying on this default.
        return field.options!.some((opt) => opt.value === value);
    }
  }

  const STORAGE_KEY = "thaimusicxml-playground-settings";

  function loadOverrides(): Record<string, unknown> {
    const overrides: Record<string, unknown> = {};
    for (const field of FIELDS)
      overrides[field.path] = getPath(defaults, field.path);

    let saved: unknown;
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) saved = JSON.parse(raw);
    } catch {
      saved = undefined;
    }
    if (saved && typeof saved === "object") {
      for (const field of FIELDS) {
        const value = (saved as Record<string, unknown>)[field.path];
        if (value === undefined) continue;
        const ok = field.validate
          ? field.validate(value)
          : defaultValidate(field, value);
        if (ok) overrides[field.path] = value;
      }
    }
    return overrides;
  }

  function saveOverrides(overrides: Record<string, unknown>): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(overrides));
    } catch {
      // Storage full or unavailable (private browsing) - settings just
      // won't persist; nothing else on the page depends on it.
    }
  }

  function buildOptions(
    overrides: Record<string, unknown>,
  ): Record<string, unknown> {
    // defaults is plain JSON-safe data, so a round-trip is a safe deep clone
    // - layout()/draw() each shallow-merge {...defaults, ...options}, so a
    // partial `page` object or `gapScale` array here would blank out
    // whichever sibling fields the user didn't just touch.
    const options = JSON.parse(JSON.stringify(defaults));
    for (const field of FIELDS)
      setPath(options, field.path, overrides[field.path]);
    return options;
  }

  const overrides = loadOverrides();

  // Appends a label and its control as two direct children of `grid` - not
  // wrapped in a row div - since .settings-grid's two-column template lays
  // out its direct children in label/control pairs, one pair per grid row.
  function buildFieldRow(
    grid: HTMLElement,
    field: FieldDef,
    onChange: () => void,
  ): void {
    const id = `setting-${field.path.replace(/\./g, "-")}`;

    const label = document.createElement("label");
    label.htmlFor = id;
    label.textContent = field.label[lang];
    grid.appendChild(label);

    const current = overrides[field.path];
    let el: HTMLInputElement | HTMLSelectElement;

    if (field.type === "select") {
      const select = document.createElement("select");
      select.id = id;
      for (const opt of field.options!) {
        const o = document.createElement("option");
        o.value = opt.value;
        o.textContent = opt.label[lang];
        select.appendChild(o);
      }
      select.value = field.encode ? field.encode(current) : String(current);
      select.addEventListener("change", () => {
        overrides[field.path] = field.decode
          ? field.decode(select.value)
          : select.value;
        onChange();
      });
      el = select;
    } else {
      const input = document.createElement("input");
      input.id = id;
      input.type = field.type;
      if (field.type === "number") {
        if (field.min !== undefined) input.min = String(field.min);
        if (field.max !== undefined) input.max = String(field.max);
        if (field.step !== undefined) input.step = String(field.step);
      }
      if (field.type === "checkbox") {
        input.checked = Boolean(current);
      } else {
        input.value = field.encode ? field.encode(current) : String(current);
      }
      const eventName = field.type === "checkbox" ? "change" : "input";
      input.addEventListener(eventName, () => {
        overrides[field.path] =
          field.type === "checkbox"
            ? input.checked
            : field.type === "number"
              ? Number(input.value)
              : input.value;
        onChange();
      });
      el = input;
    }

    grid.appendChild(el);
  }

  let renderTimer: ReturnType<typeof setTimeout> | undefined;
  const scheduleRender = () => {
    clearTimeout(renderTimer);
    renderTimer = setTimeout(renderPreview, 400);
  };

  const onSettingChange = () => {
    saveOverrides(overrides);
    scheduleRender();
  };

  // --- Settings overlay: two-level category nav + a single field grid for
  // whichever category is currently selected, instead of one long scrolling
  // list of every field at once. ---
  let activeGroupKey = "notation";

  function renderFields(): void {
    settingsFieldsGrid.innerHTML = "";
    for (const field of FIELDS.filter((f) => f.group === activeGroupKey))
      buildFieldRow(settingsFieldsGrid, field, onSettingChange);
  }

  function updateNavActiveState(): void {
    for (const button of settingsNav.querySelectorAll("button"))
      button.setAttribute(
        "aria-current",
        String((button as HTMLElement).dataset.group === activeGroupKey),
      );
  }

  function selectGroup(key: string): void {
    activeGroupKey = key;
    renderFields();
    updateNavActiveState();
  }

  function renderNav(): void {
    settingsNav.innerHTML = "";
    for (const tier of TIERS) {
      const tierGroups = GROUPS.filter((g) => g.tier === tier);
      if (tierGroups.length === 0) continue;
      const heading = document.createElement("div");
      heading.className = "settings-nav-tier";
      heading.textContent = TIER_LABELS[tier][lang];
      settingsNav.appendChild(heading);
      for (const group of tierGroups) {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = group.label[lang];
        button.dataset.group = group.key;
        button.addEventListener("click", () => selectGroup(group.key));
        settingsNav.appendChild(button);
      }
    }
    updateNavActiveState();
  }

  renderNav();
  renderFields();

  settingsResetButton.addEventListener("click", () => {
    localStorage.removeItem(STORAGE_KEY);
    for (const field of FIELDS)
      overrides[field.path] = getPath(defaults, field.path);
    saveOverrides(overrides);
    renderFields();
    scheduleRender();
  });

  function setSettingsOpen(open: boolean): void {
    settingsOverlay.hidden = !open;
    settingsToggleButton.setAttribute("aria-expanded", String(open));
  }

  settingsToggleButton.addEventListener("click", () =>
    setSettingsOpen(settingsOverlay.hidden),
  );
  settingsCloseButton.addEventListener("click", () => setSettingsOpen(false));

  // Native <details> doesn't close itself on an outside click - this menu
  // should behave like a normal desktop menu bar, so it gets that behavior
  // explicitly. The second listener closes it after a format is actually
  // chosen, so picking SVG/PNG/PDF both triggers the download and dismisses
  // the menu in one click.
  document.addEventListener("click", (e) => {
    if (exportDetails.open && !exportDetails.contains(e.target as Node))
      exportDetails.removeAttribute("open");
  });
  exportPanel.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "BUTTON")
      exportDetails.removeAttribute("open");
  });

  // --- File lifecycle: dirty tracking, import, save, save as ---
  //
  // `fileHandle` is a live FileSystemFileHandle where the File System Access
  // API is available (Chromium browsers) and the current buffer came from
  // Import or a prior Save/Save As - it is what lets Save write straight
  // back to that file with no download prompt and no second copy on disk.
  // It is null after loading a template (nothing on disk to write back to
  // yet) and on any browser without the API, where every Save is
  // necessarily a fresh download instead.
  let fileHandle: any = null;
  let dirty = false;

  const updateFileStatus = () => {
    const name = fileHandle?.name;
    fileStatusEl.textContent = name
      ? `${dirty ? "● " : ""}${name}`
      : dirty
        ? t({ en: "● unsaved changes", th: "● มีการแก้ไขที่ยังไม่ได้บันทึก" })
        : "";
  };
  const markDirty = () => {
    dirty = true;
    updateFileStatus();
  };
  const markClean = () => {
    dirty = false;
    updateFileStatus();
  };

  // A close/reload with unsaved changes gets the browser's own confirmation
  // prompt - `dirty` is exactly "the buffer differs from what Save last
  // wrote (or what Import/a template last loaded)", so this fires only when
  // there is genuinely something Save would still have to do.
  window.addEventListener("beforeunload", (e) => {
    if (!dirty) return;
    e.preventDefault();
    e.returnValue = "";
  });

  const loadIntoEditor = (text: string) => {
    const model = editor.getModel()!;
    editor.executeEdits("load-template", [
      { range: model.getFullModelRange(), text },
    ]);
  };

  const monoFont =
    getComputedStyle(document.documentElement)
      .getPropertyValue("--__sl-font-mono")
      .trim() || "monospace";

  const editor = monaco.editor.create(editorPane, {
    value: templateSource("example-lao-duang-duean.txml"),
    language: "xml",
    automaticLayout: true,
    minimap: { enabled: false },
    // Code folding is not something this playground needs, and its chevron
    // column only adds noise next to the line numbers.
    folding: true,
    fontSize: 13,
    fontFamily: monoFont,
    scrollBeyondLastLine: false,
    // The suggest/hover widgets default to clipping at the editor's own
    // box - this pane's overflow: hidden (see the stylesheet) would clip
    // them the moment a suggestion list runs past the visible bottom edge,
    // so they attach to the document instead.
    fixedOverflowWidgets: true,
  });
  initMonacoTheme(monaco);

  editor.onDidChangeModelContent(() => {
    scheduleRender();
    markDirty();
  });

  templateSelect.addEventListener("change", () => {
    loadIntoEditor(templateSource(templateSelect.value));
    // A template is a fresh start, not an edit to whatever file was open -
    // nothing on disk to fall out of sync with yet.
    fileHandle = null;
    markClean();
  });

  // queryPermission()/requestPermission() are asked for at save time, not
  // right after Import: asking only when a write is actually about to
  // happen is the documented File System Access pattern, and it means a
  // read-only visit (import, look, never save) never prompts at all.
  const canWrite = async (handle: any): Promise<boolean> => {
    const opts = { mode: "readwrite" };
    if ((await handle.queryPermission(opts)) === "granted") return true;
    return (await handle.requestPermission(opts)) === "granted";
  };

  const saveAs = async (content: string) => {
    const handle = await (window as any).showSaveFilePicker({
      suggestedName: `${baseNameFor(content)}.txml`,
      types: [
        {
          description: "ThaiMusicXML",
          accept: { "application/xml": [".txml"] },
        },
      ],
    });
    const writable = await handle.createWritable();
    await writable.write(content);
    await writable.close();
    fileHandle = handle;
  };

  // Save and Save As share this: with no file open yet they behave
  // identically (both prompt for a new file, or fall back to a plain
  // download where the File System Access API doesn't exist). Once a file
  // is open, Save writes straight back to it; Save As (forceNew) always
  // re-prompts and switches the current target to whatever the user picks,
  // same as Save As in any desktop editor.
  const performSave = async (forceNew: boolean): Promise<void> => {
    const content = editor.getValue();
    try {
      if (fileHandle && !forceNew) {
        if (!(await canWrite(fileHandle))) {
          statusEl.textContent = t({
            en: "Write permission for this file was not granted.",
            th: "ไม่ได้รับสิทธิ์เขียนไฟล์นี้",
          });
          return;
        }
        const writable = await fileHandle.createWritable();
        await writable.write(content);
        await writable.close();
      } else if ("showSaveFilePicker" in window) {
        await saveAs(content);
      } else {
        // No File System Access API at all (Firefox, Safari): the best this
        // platform can do is a plain download, same mechanism as Export -
        // there is no way to avoid a second copy on disk here.
        const blob = new Blob([content], {
          type: "application/xml;charset=utf-8",
        });
        triggerDownload(blob, `${exportBaseName()}.txml`);
      }
      statusEl.textContent = "";
      markClean();
    } catch (err) {
      // The user closing the save picker without choosing anything is not a
      // failure worth reporting.
      if (err instanceof DOMException && err.name === "AbortError") return;
      statusEl.textContent = err instanceof Error ? err.message : String(err);
    }
  };

  saveButton.addEventListener("click", () => performSave(false));
  saveAsButton.addEventListener("click", () => performSave(true));

  importButton.addEventListener("click", async () => {
    if (!("showOpenFilePicker" in window)) {
      importFileInput.click();
      return;
    }
    try {
      const [handle] = await (window as any).showOpenFilePicker({
        types: [
          {
            description: "ThaiMusicXML",
            accept: { "application/xml": [".txml"] },
          },
        ],
      });
      const text = await (await handle.getFile()).text();
      loadIntoEditor(text);
      fileHandle = handle;
      markClean();
    } catch (err) {
      if (err instanceof DOMException && err.name === "AbortError") return;
      statusEl.textContent = err instanceof Error ? err.message : String(err);
    }
  });

  // The <input type="file"> fallback for browsers with no File System
  // Access API: it can read the picked file but hands back no writable
  // handle, so Save after this always falls through to a plain download.
  importFileInput.addEventListener("change", async () => {
    const file = importFileInput.files?.[0];
    importFileInput.value = "";
    if (!file) return;
    loadIntoEditor(await file.text());
    fileHandle = null;
    markClean();
  });

  // --- Export: SVG, PNG, PDF ---
  //
  // Each export button acts on the last successfully rendered score, not on
  // whatever is in the editor right now: the two agree except while the
  // editor holds text that fails to parse, and exporting a blank or partial
  // score then would be worse than exporting the last good one. The buttons
  // are disabled instead while that gap exists (see the `catch` branch of
  // renderPreview() below), so "last successful" and "the buttons are even
  // clickable" stay the same condition.
  let lastSource = "";
  let lastWidth = 0;
  let lastHeight = 0;
  let lastSvgs: string[] = [];

  const setExportEnabled = (enabled: boolean) => {
    for (const button of [exportSvgButton, exportPngButton, exportPdfButton])
      button.disabled = !enabled;
  };
  setExportEnabled(false);

  // A source's own <title>, filesystem-safe: strip characters no target
  // platform's filesystem accepts, since a title is free text and Thai
  // scores' titles are not filename-shaped by nature. Falls back to a plain
  // name where the title is empty or entirely made of such characters.
  const baseNameFor = (source: string): string => {
    try {
      const title = parse(source)?.title;
      const safe = String(title ?? "")
        .replace(/[/\\:*?"<>|]/g, " ")
        .trim();
      return safe || "score";
    } catch {
      return "score";
    }
  };
  const exportBaseName = (): string => baseNameFor(lastSource);

  const triggerDownload = (blob: Blob, filename: string) => {
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  };

  // One file per page for SVG/PNG rather than trying to merge several pages
  // into a single image: each page is already its own self-contained,
  // correctly-sized document (draw() embeds the font itself), and a reader
  // opening "score.svg" for a one-page score should not have to guess
  // whether a second page exists.
  const pageFilename = (
    base: string,
    ext: string,
    index: number,
    total: number,
  ) => (total > 1 ? `${base}-p${index + 1}.${ext}` : `${base}.${ext}`);

  exportSvgButton.addEventListener("click", () => {
    const base = exportBaseName();
    lastSvgs.forEach((svg, i) => {
      const blob = new Blob([svg], { type: "image/svg+xml;charset=utf-8" });
      triggerDownload(blob, pageFilename(base, "svg", i, lastSvgs.length));
    });
  });

  // Rasterizes by loading the SVG (already self-contained, font and all) as
  // an <img> and drawing it to a <canvas> - no extra dependency for
  // something a browser already knows how to do. `scale` renders at 2x the
  // page's own point size, since a viewer or printer treating those points
  // as CSS pixels 1:1 would otherwise get a noticeably soft image.
  const svgToPngBlob = (
    svg: string,
    width: number,
    height: number,
    scale = 2,
  ): Promise<Blob> =>
    new Promise((resolve, reject) => {
      const svgUrl = URL.createObjectURL(
        new Blob([svg], { type: "image/svg+xml;charset=utf-8" }),
      );
      const img = new Image();
      img.onload = () => {
        URL.revokeObjectURL(svgUrl);
        const canvas = document.createElement("canvas");
        canvas.width = Math.round(width * scale);
        canvas.height = Math.round(height * scale);
        const ctx = canvas.getContext("2d");
        if (!ctx) return reject(new Error("canvas 2D context unavailable"));
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        canvas.toBlob(
          (blob) =>
            blob ? resolve(blob) : reject(new Error("PNG export failed")),
          "image/png",
        );
      };
      img.onerror = () => {
        URL.revokeObjectURL(svgUrl);
        reject(new Error("could not rasterize the preview SVG"));
      };
      img.src = svgUrl;
    });

  exportPngButton.addEventListener("click", async () => {
    const base = exportBaseName();
    exportPngButton.disabled = true;
    try {
      for (let i = 0; i < lastSvgs.length; i++) {
        const blob = await svgToPngBlob(lastSvgs[i], lastWidth, lastHeight);
        triggerDownload(blob, pageFilename(base, "png", i, lastSvgs.length));
      }
    } catch (err) {
      statusEl.textContent = err instanceof Error ? err.message : String(err);
    } finally {
      exportPngButton.disabled = false;
    }
  });

  // A blank popup holding just the rendered pages, sized to them exactly via
  // @page, then handed to the browser's own print dialog - "Save as PDF"
  // there is the export. Building a PDF directly would mean a bundled
  // library (jsPDF/svg2pdf.js and the bundle weight that brings) just to
  // redo work the browser already does for free; a plain new window (opened
  // synchronously, in direct response to the click, so no popup blocker
  // intervenes) keeps this page's own toolbar and editor out of the printed
  // output without fighting Starlight's site chrome in print media.
  exportPdfButton.addEventListener("click", () => {
    const printWindow = window.open("", "_blank");
    if (!printWindow) {
      statusEl.textContent = t({
        en: "Could not open the print window - check your browser's popup blocker.",
        th: "เปิดหน้าต่างพิมพ์ไม่ได้ - โปรดตรวจสอบตัวบล็อกป๊อปอัปของเบราว์เซอร์",
      });
      return;
    }
    const title = exportBaseName();
    printWindow.document.write(
      `<!doctype html><html><head><title>${title}</title><style>` +
        `@page { size: ${lastWidth}pt ${lastHeight}pt; margin: 0; }` +
        `html, body { margin: 0; padding: 0; }` +
        `svg { display: block; width: ${lastWidth}pt; height: ${lastHeight}pt; page-break-after: always; }` +
        `svg:last-child { page-break-after: auto; }` +
        `</style></head><body>${lastSvgs.join("")}</body></html>`,
    );
    printWindow.document.close();
    printWindow.onload = () => {
      printWindow.focus();
      printWindow.print();
    };
  });

  function renderPreview() {
    const source = editor.getValue();
    const options = buildOptions(overrides);
    try {
      const laidOut = layout(parse(source), options);
      const svgs = laidOut.pages.map((page: { elements: unknown }) =>
        draw(
          {
            width: laidOut.width,
            height: laidOut.height,
            elements: page.elements,
          },
          options,
        ),
      );
      previewPane.innerHTML = svgs.join("");
      statusEl.textContent = "";
      lastSource = source;
      lastWidth = laidOut.width;
      lastHeight = laidOut.height;
      lastSvgs = svgs;
      setExportEnabled(true);
    } catch (err) {
      statusEl.textContent = err instanceof Error ? err.message : String(err);
      setExportEnabled(false);
    }
  }

  // --- Draggable divider: splits horizontally while the panes sit side by
  // side, vertically once they stack. ---
  let ratio = 0.5;
  const applyRatio = () => {
    (editorPane as HTMLElement).style.flexGrow = String(ratio);
    (previewPane as HTMLElement).style.flexGrow = String(1 - ratio);
  };
  applyRatio();

  // Asking the layout which way it went, rather than re-testing the width
  // here: the switch is a container query now (see the <style> block), and
  // matchMedia cannot express one. Reading the resolved flex-direction also
  // means the drag axis cannot drift from the CSS if the threshold moves.
  const isRow = () => getComputedStyle(split).flexDirection === "row";
  let dragging = false;
  divider.addEventListener("pointerdown", (e) => {
    dragging = true;
    divider.setPointerCapture(e.pointerId);
  });
  divider.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    const rect = split.getBoundingClientRect();
    const pos = isRow()
      ? (e.clientX - rect.left) / rect.width
      : (e.clientY - rect.top) / rect.height;
    ratio = Math.min(0.85, Math.max(0.15, pos));
    applyRatio();
  });
  const stopDrag = (e: PointerEvent) => {
    dragging = false;
    divider.releasePointerCapture(e.pointerId);
  };
  divider.addEventListener("pointerup", stopDrag);
  divider.addEventListener("pointercancel", stopDrag);

  await ready();
  renderPreview();
</script>
