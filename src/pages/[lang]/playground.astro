  // targetExists/currentLyricChoice also back buildLyricsMap() further
  // below - a saved choice survives an edit or a splitStacks toggle only if
  // it still names something in the current document.
  function targetExists(groups: any[], targetId: string): boolean {
    return groups.some(
      (g) =>
        g.id === targetId ||
        g.members.some((m: any) => m.id === targetId),
    );
  }

  function currentLyricChoice(
    groups: any[],
    lyricPartId: string,
    index: number,
  ): string {
    const saved = lyricsMapChoices[lyricPartId];
    if (saved !== undefined && (saved === "drop" || targetExists(groups, saved)))
      return saved;
    // The converter's own implicit default: the first lyric part (ensemble
    // order) pairs to the first notated group, every other one drops.
    return index === 0 && groups.length > 0 ? groups[0].id : "drop";
  }

  function renderLyricsMapRows(grid: HTMLElement): void {
    if (!lastResolvedDoc) return;
    const doc = lastResolvedDoc;
    const splitStacks = Boolean(CONVERTER_REGISTRY.overrides.splitStacks);
    const lyricParts = doc.parts.filter((p: any) => p.type === "lyric");
    if (lyricParts.length === 0) return;
    const groups = groupParts(
      doc.parts.filter((p: any) => p.type !== "lyric"),
      splitStacks,
    );

    const note = document.createElement("p");
    note.className = "settings-note";
    note.textContent = t({
      en: "Pair each lyric part to the notated part or stack row it's sung over.",
      th: "จับคู่เนื้อร้องแต่ละส่วนกับเครื่องดนตรีหรือแถวที่ขับร้องทับ",
    });
    grid.appendChild(note);

    lyricParts.forEach((part: any, i: number) => {
      const id = `converter-lyrics-map-${part.id}`;
      const label = document.createElement("label");
      label.htmlFor = id;
      label.textContent = part.name || part.id;
      grid.appendChild(label);

      const select = document.createElement("select");
      select.id = id;
      const dropOption = document.createElement("option");
      dropOption.value = "drop";
      dropOption.textContent = t({
        en: "Drop (not exported)",
        th: "ไม่ส่งออก",
      });
      select.appendChild(dropOption);
      for (const g of groups) {
        const opt = document.createElement("option");
        opt.value = g.id;
        opt.textContent = g.name;
        select.appendChild(opt);
        if (g.members.length > 1) {
          for (const member of g.members) {
            const memberOpt = document.createElement("option");
            memberOpt.value = member.id;
            memberOpt.textContent = `${g.name} — ${member.name || member.id}`;
            select.appendChild(memberOpt);
          }
        }
      }
      select.value = currentLyricChoice(groups, part.id, i);
      select.addEventListener("change", () => {
        lyricsMapChoices[part.id] = select.value;
        saveConverterMaps();
        scheduleConverterRender();
      });
      grid.appendChild(select);
    });
  }

  function renderMidiMapRows(grid: HTMLElement): void {
    const note = document.createElement("p");
    note.className = "settings-note";
    note.textContent = t({
      en: "These settings only affect the downloaded MIDI file, not the MusicXML view.",
      th: "การตั้งค่านี้มีผลต่อไฟล์ MIDI ที่ดาวน์โหลดเท่านั้น ไม่มีผลต่อมุมมอง MusicXML",
    });
    grid.appendChild(note);

    if (!lastResolvedDoc) return;
    const doc = lastResolvedDoc;
    const splitStacks = Boolean(CONVERTER_REGISTRY.overrides.splitStacks);
    const groups = groupParts(
      doc.parts.filter((p: any) => p.type !== "lyric"),
      splitStacks,
    );

    const instrumentNames: string[] = [];
    for (const g of groups) {
      if (g.members[0].type === "unpitched") continue;
      if (!instrumentNames.includes(g.members[0].name))
        instrumentNames.push(g.members[0].name);
    }
    for (const name of instrumentNames) {
      const id = `converter-instrument-map-${name}`;
      const label = document.createElement("label");
      label.htmlFor = id;
      label.textContent = name;
      grid.appendChild(label);

      const select = document.createElement("select");
      select.id = id;
      const autoOption = document.createElement("option");
      autoOption.value = "auto";
      autoOption.textContent = t({ en: "Auto", th: "อัตโนมัติ" });
      select.appendChild(autoOption);
      for (const family of GM_INSTRUMENT_FAMILIES) {
        const optgroup = document.createElement("optgroup");
        optgroup.label = family.family;
        for (const instrument of family.instruments) {
          const opt = document.createElement("option");
          opt.value = String(instrument.program);
          opt.textContent = instrument.name;
          optgroup.appendChild(opt);
        }
        select.appendChild(optgroup);
      }
      select.value = instrumentMapChoices[name] ?? "auto";
      select.addEventListener("change", () => {
        instrumentMapChoices[name] = select.value;
        saveConverterMaps();
        scheduleConverterRender();
      });
      grid.appendChild(select);
    }

    const soundCodes: string[] = [];
    for (const g of groups) {
      if (g.members[0].type !== "unpitched") continue;
      for (const member of g.members) {
        for (const n of doc.unroll(member.id).notes) {
          if (!n.rest && n.sound != null && !soundCodes.includes(n.sound))
            soundCodes.push(n.sound);
        }
      }
    }
    for (const code of soundCodes) {
      const id = `converter-percussion-map-${code}`;
      const label = document.createElement("label");
      label.htmlFor = id;
      label.textContent = code;
      grid.appendChild(label);

      const select = document.createElement("select");
      select.id = id;
      const autoOption = document.createElement("option");
      autoOption.value = "auto";
      autoOption.textContent = t({ en: "Auto", th: "อัตโนมัติ" });
      select.appendChild(autoOption);
      for (const p of GM_PERCUSSION_NOTES) {
        const opt = document.createElement("option");
        opt.value = String(p.note);
        opt.textContent = p.name;
        select.appendChild(opt);
      }
      select.value = percussionMapChoices[code] ?? "auto";
      select.addEventListener("change", () => {
        percussionMapChoices[code] = select.value;
        saveConverterMaps();
        scheduleConverterRender();
      });
      grid.appendChild(select);
    }
  }

