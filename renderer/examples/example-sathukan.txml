<?xml version="1.0" encoding="UTF-8"?>
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/0.1" version="0.1">
  <header>
    <title>สาธุการ</title>
    <composer>ไม่ปรากฏนามผู้แต่ง (เพลงหน้าพาทย์โบราณ)</composer>
    <arranger>ถอดโน้ตจาก นพรัตน์ พวงสมบัติ (โน้ตเพลงชุดโหมโรงเช้า, ทางฆ้องวงใหญ่)</arranger>
  </header>
  <structure>
    <annotation>ทางฆ้องวงใหญ่ (ทำนองหลัก)</annotation>
    <section id="s1" name="ส่วนนำ" />
    <annotation><text align="center">เที่ยวสองเริ่มจากบรรทัดนี้</text></annotation>
    <section id="s2" name="ท่อน 1" />
    <annotation><text align="center">เที่ยวสองบรรเลงถึงบรรทัดนี้</text></annotation>
    <section id="s3" name="ท่อน 2" />
    <annotation><text align="center">กลับต้น/รับจากเที่ยวกลับด้วยท่อนนี้</text></annotation>
    <section id="s4" name="ท่อนรับ" />
  </structure>
  <ensemble>
