      <line number="3">
        <measure number="1"><rest/><rest/><rest/><note sound="ฉิ่ง"/></measure>
        <measure number="2"><rest/><rest/><rest/><note sound="ฉับ"/></measure>
        <measure number="3"><rest/><rest/><rest/><note sound="ฉิ่ง"/></measure>
        <measure number="4"><rest/><rest/><rest/><note sound="ฉับ"/></measure>
