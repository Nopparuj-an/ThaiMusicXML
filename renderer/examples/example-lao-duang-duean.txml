<?xml version="1.0" encoding="UTF-8"?>
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/0.1" version="0.1">
  <header>
    <title>ลาวดวงเดือน</title>
    <composer><text align="right">ทำนอง: พระเจ้าบรมวงศ์เธอ กรมหมื่นพิไชยมหินทโรดม</text></composer>
    <lyricist><text align="right">เนื้อร้อง: พระเจ้าบรมวงศ์เธอ กรมหมื่นพิไชยมหินทโรดม</text></lyricist>
    <arranger><text align="right">รวบรวมและดัดแปลงจากหลายแหล่ง</text></arranger>
    <license>PUBLIC DOMAIN</license>
    <tuning reference="khrueang-sai"/>
  </header>
  <structure>
    <br/>
    <annotation>เพลงลาวดำเนินเกวียน (นิยมเรียกว่า ลาวดวงเดือน) เป็นเพลงไทยเดิมพระนิพนธ์ของพระเจ้าบรมวงศ์เธอ กรมหมื่นพิไชยมหินทโรดม พระราชโอรสพระองค์ที่ 41 ของพระบาทสมเด็จพระจุลจอมเกล้าเจ้าอยู่หัว</annotation>
    <br/>
    <direction>
      <nathap value="ลาว" />
      <chan value="2" />
      <bpm>60</bpm>
    </direction>
    <repeat times="2">
      <annotation>ท่อน 1</annotation>
      <section id="s1" name="ท่อน 1"/>
      <annotation>
        <text align="right">(กลับต้น)</text>
      </annotation>
    </repeat>
    <repeat times="2">
      <annotation>ท่อน 2</annotation>
      <section id="s2" name="ท่อน 2">
        <line-repeat first="5" last="5" times="2"/>
      </section>
      <annotation>
        <text align="right">(กลับต้น)</text>
      </annotation>
    </repeat>
    <repeat times="2">
      <annotation>ท่อน 3</annotation>
      <section id="s3" name="ท่อน 3">
        <line-repeat first="1" last="2" times="2"/>
        <line-repeat first="4" last="4" times="2"/>
      </section>
      <annotation>
        <text align="right">(กลับต้น)</text>
      </annotation>
    </repeat>
  </structure>
  <ensemble>
    <part id="lyric" type="lyric">
      <instrument-name>เนื้อร้อง</instrument-name>
    </part>
    <part id="ranad-ek">
      <instrument-name>ระนาดเอก</instrument-name>
      <instrument-short-name>รน.เอก</instrument-short-name>
    </part>
    <part id="saw-u">
      <instrument-name>ซออู้</instrument-name>
    </part>
    <part id="khim1" stack="khim" row="1">
      <instrument-name>ขิม 1</instrument-name>
    </part>
    <part id="khim2" stack="khim" row="2">
      <instrument-name>ขิม 2</instrument-name>
    </part>
    <part id="khim3" stack="khim" row="3">
      <instrument-name>ขิม 3</instrument-name>
    </part>
  </ensemble>
