{
  "makefile.configureOnOpen": false,

  // Paste or drop an image into a docs page: the file is written under
  // src/assets/docs/, mirroring the page path with the locale segment stripped
  // (en/v1_0/reference/elements/note.md -> src/assets/docs/v1_0/reference/elements/note/),
  // and the relative link is inserted. Select the alt text before pasting and it
  // is kept as the alt text. Works in .md, not .mdx.
  "markdown.copyFiles.destination": {
    "/src/content/docs/**/*": "/src/assets/docs/${documentRelativeFilePath/src\\/content\\/docs\\/[a-z]+\\/(.*)\\.mdx?$/$1/}/"
  },
  "markdown.copyFiles.overwriteBehavior": "nameIncrementally",

  // F2 to rename a pasted image; links to it are rewritten.
  "markdown.updateLinksOnFileMove.enabled": "always"
}
