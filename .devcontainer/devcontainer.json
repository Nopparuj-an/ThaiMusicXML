{
  "name": "ThaiMusicXML DevContainer",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "pnpmVersion": "latest"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },

  // Prevent host SSH agent and Git credentials from being mounted/passed into the container
  "remoteEnv": {
    "SSH_AUTH_SOCK": ""
  },

  // Security & standard dev environment setup
  "postCreateCommand": "sudo corepack enable && pnpm install",

  "customizations": {
    "vscode": {
      "settings": {
        // Prevent VS Code from forwarding host Git credentials into the container
        "dev.containers.copyGitConfig": false
        // "dev.containers.gitCredentialHelperConfigLocation": "none"
      },
      "extensions": ["astro-build.astro-vscode", "esbenp.prettier-vscode"]
    }
  },

  // Run as non-root user
  "remoteUser": "node"
}
