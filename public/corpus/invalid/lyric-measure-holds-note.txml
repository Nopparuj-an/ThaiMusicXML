<?xml version="1.0" encoding="UTF-8"?>
<!-- INVALID: A lyric part's measures hold only syllable and rest. -->
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/0.1" version="0.1">
  <header><title>Invalid example</title></header>
  <structure><section id="s1"/></structure>
  <ensemble>
    <part id="P1" type="lyric"><instrument-name>เนื้อร้อง</instrument-name></part>
  </ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1">
        <measure number="1"><syllable>ละ</syllable><note pitch="ด"/></measure>
      </line>
    </section-ref>
  </part-data>
</thai-score>
