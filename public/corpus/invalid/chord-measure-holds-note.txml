<?xml version="1.0" encoding="UTF-8"?>
<!-- INVALID: a <note> in a chord part's measure. A chord measure holds only
     <chord> and <rest>. -->
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/1" version="1.0">
  <header><title>Invalid example</title></header>
  <structure><section id="s1"/></structure>
  <ensemble>
    <part id="P1" type="chord"><instrument-name>คอร์ด</instrument-name></part>
    <part id="P2"><instrument-name>ระนาดเอก</instrument-name></part>
  </ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1">
        <measure number="1"><chord>Am</chord><note pitch="ด"/></measure>
      </line>
    </section-ref>
  </part-data>
  <part-data part="P2">
    <section-ref section="s1">
      <line number="1">
        <measure number="1"><note pitch="ด"/><note pitch="ร"/></measure>
      </line>
    </section-ref>
  </part-data>
</thai-score>
