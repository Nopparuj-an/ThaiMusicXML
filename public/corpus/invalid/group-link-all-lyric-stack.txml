<?xml version="1.0" encoding="UTF-8"?>
<!-- INVALID: link needs at least one other notated row in the stack. A lyric
     part may carry stack, but a lyric measure holds words rather than beats,
     so there is no position for the connector to reach. -->
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/0.1" version="0.1">
  <header><title>Invalid example</title></header>
  <structure><section id="s1"/></structure>
  <ensemble>
    <part id="P1" stack="song" row="1"><instrument-name>ขิม</instrument-name></part>
    <part id="P2" type="lyric" stack="song" row="2"><instrument-name>เนื้อร้อง</instrument-name></part>
  </ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1">
        <measure number="1">
          <group link="true"><note pitch="ด"/><note pitch="ร"/></group>
        </measure>
      </line>
    </section-ref>
  </part-data>
  <part-data part="P2">
    <section-ref section="s1">
      <line number="1">
        <measure number="1"><syllable>ละ</syllable></measure>
      </line>
    </section-ref>
  </part-data>
</thai-score>
