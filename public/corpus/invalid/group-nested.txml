  <header>
    <title>Invalid example</title>
  </header>
  <structure>
    <section id="s1" name="ท่อน 1"/>
  </structure>
  <ensemble>
    <part id="P1">
      <instrument-name>ระนาดเอก</instrument-name>
    </part>
  </ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1">
        <measure number="1">
          <group>
            <note pitch="ด"/>
            <group><note pitch="ร"/><note pitch="ม"/></group>
          </group>
          <note pitch="ซ"/><note pitch="ล"/><note pitch="ท"/>
        </measure>
      </line>
    </section-ref>
