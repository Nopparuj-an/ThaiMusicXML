<?xml version="1.0" encoding="UTF-8"?>
<!-- INVALID: A stack value must be shared by at least two parts. One part alone is a single-row instrument and carries neither attribute. -->
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/1" version="1.0">
  <header><title>Invalid example</title></header>
  <structure><section id="s1"/></structure>
  <ensemble>
    <part id="P1" stack="khong" row="1"><instrument-name>ฆ้องวงใหญ่</instrument-name></part>
  </ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1"><measure number="1"><note pitch="ด"/></measure></line>
    </section-ref>
  </part-data>
</thai-score>
