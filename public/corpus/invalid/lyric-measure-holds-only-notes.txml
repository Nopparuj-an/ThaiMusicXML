<?xml version="1.0" encoding="UTF-8"?>
<!-- INVALID: A lyric part's measures hold syllable and rest. This measure holds
     notes, which the grammar accepts on its own because a part's type is
     declared in <ensemble>, out of the grammar's reach. -->
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/1" version="1.0">
  <header><title>Invalid example</title></header>
  <structure><section id="s1"/></structure>
  <ensemble>
    <part id="P1" type="lyric"><instrument-name>เนื้อร้อง</instrument-name></part>
  </ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1">
        <measure number="1"><note pitch="ด"/><note pitch="ร"/></measure>
      </line>
    </section-ref>
  </part-data>
</thai-score>
