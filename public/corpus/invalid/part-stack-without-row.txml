<?xml version="1.0" encoding="UTF-8"?>
<!-- INVALID: stack and row must appear together. A part with stack must also carry row. -->
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/1" version="1.0">
  <header><title>Invalid example</title></header>
  <structure><section id="s1"/></structure>
  <ensemble>
    <part id="P1" stack="khong"><instrument-name>ฆ้องวงใหญ่ มือขวา</instrument-name></part>
    <part id="P2" stack="khong" row="2"><instrument-name>ฆ้องวงใหญ่ มือซ้าย</instrument-name></part>
  </ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1"><measure number="1"><note pitch="ด"/></measure></line>
    </section-ref>
  </part-data>
  <part-data part="P2">
    <section-ref section="s1">
      <line number="1"><measure number="1"><note pitch="ดฺ"/></measure></line>
    </section-ref>
  </part-data>
</thai-score>
