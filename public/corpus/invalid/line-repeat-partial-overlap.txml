<?xml version="1.0" encoding="UTF-8"?>
<!-- INVALID: Two line-repeat ranges must be properly nested or wholly disjoint. These partially overlap. -->
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/1" version="1.0">
  <header><title>Invalid example</title></header>
  <structure>
    <section id="s1">
      <line-repeat first="1" last="3" times="2"/>
      <line-repeat first="2" last="4" times="2"/>
    </section>
  </structure>
  <ensemble><part id="P1"><instrument-name>จะเข้</instrument-name></part></ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1"><measure number="1"><note pitch="ด"/></measure></line>
      <line number="2"><measure number="1"><note pitch="ร"/></measure></line>
      <line number="3"><measure number="1"><note pitch="ม"/></measure></line>
      <line number="4"><measure number="1"><note pitch="ซ"/></measure></line>
    </section-ref>
  </part-data>
</thai-score>
