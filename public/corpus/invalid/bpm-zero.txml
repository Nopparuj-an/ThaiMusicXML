<!-- INVALID: bpm content must be a positive integer. -->
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/0.1" version="0.1">
  <header><title>Invalid example</title></header>
  <structure>
    <direction><bpm>0</bpm></direction>
    <section id="s1"/>
  </structure>
  <ensemble><part id="P1"><instrument-name>ระนาดเอก</instrument-name></part></ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1"><measure number="1"><note pitch="ด"/></measure></line>
    </section-ref>
  </part-data>
</thai-score>
