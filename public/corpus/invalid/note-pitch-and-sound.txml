  <ensemble>
    <part id="P1">
      <instrument-name>ระนาดเอก</instrument-name>
    </part>
  </ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1">
        <measure number="1">
          <note pitch="ด" sound="0"/><note pitch="ร"/><note pitch="ม"/><note pitch="ซ"/>
        </measure>
      </line>
    </section-ref>
  </part-data>
</thai-score>
