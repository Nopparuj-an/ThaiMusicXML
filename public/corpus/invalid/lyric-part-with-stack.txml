<?xml version="1.0" encoding="UTF-8"?>
<!-- INVALID: a lyric part carries stack. A stack is one instrument's own rows,
     and words are not a region of an instrument, so a lyric part sits beside a
     stack rather than joining one. -->
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/1" version="1.0">
  <header><title>Invalid example</title></header>
  <structure><section id="s1"/></structure>
  <ensemble>
    <part id="P1" stack="song" row="1"><instrument-name>ขิม</instrument-name></part>
    <part id="P2" type="lyric" stack="song" row="2"><instrument-name>เนื้อร้อง</instrument-name></part>
  </ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1">
        <measure number="1"><note pitch="ด"/><note pitch="ร"/></measure>
      </line>
    </section-ref>
  </part-data>
  <part-data part="P2">
    <section-ref section="s1">
      <line number="1">
        <measure number="1"><syllable>ละ</syllable></measure>
      </line>
    </section-ref>
  </part-data>
</thai-score>
