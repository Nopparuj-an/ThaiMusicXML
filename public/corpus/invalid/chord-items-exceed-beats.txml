<?xml version="1.0" encoding="UTF-8"?>
<!-- INVALID: five items in a chord measure where the notated part has four
     beats. Every chord item claims a beat, so the fifth has nowhere to go.
     This is the one count a chord part is held to; below the ceiling it is as
     free of the beat grid as a lyric part. -->
<thai-score xmlns="https://thaimusicxml.anan.ovh/ns/1" version="1.0">
  <header><title>Invalid example</title></header>
  <structure><section id="s1"/></structure>
  <ensemble>
    <part id="P1" type="chord"><instrument-name>คอร์ด</instrument-name></part>
    <part id="P2"><instrument-name>ระนาดเอก</instrument-name></part>
  </ensemble>
  <part-data part="P1">
    <section-ref section="s1">
      <line number="1">
        <measure number="1">
          <chord>C</chord><chord>Am</chord><chord>F</chord><chord>G</chord><chord>C</chord>
        </measure>
      </line>
    </section-ref>
  </part-data>
  <part-data part="P2">
    <section-ref section="s1">
      <line number="1">
        <measure number="1">
          <note pitch="ด"/><note pitch="ร"/><note pitch="ม"/><note pitch="ซ"/>
        </measure>
      </line>
    </section-ref>
  </part-data>
</thai-score>
