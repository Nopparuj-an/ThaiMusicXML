{
  "name": "thaimusicxml",
  "type": "module",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:links": "node scripts/check-docs-links.mjs",
    "check:corpus": "node scripts/check-corpus.mjs",
    "check:layout": "node --test \"renderer/test/*.test.mjs\"",
    "check:convert": "node --test \"converter/test/*.test.mjs\"",
    "lint": "eslint .",
    "check": "pnpm run check:links && pnpm run check:corpus && pnpm run check:layout && pnpm run check:convert && pnpm run lint",
    "render": "node renderer/render.mjs"
  },
  "imports": {
    "#dom-parser": {
      "browser": "./renderer/src/dom-parser.browser.mjs",
      "default": "./renderer/src/dom-parser.node.mjs"
    },
    "#font-loader": {
      "browser": "./renderer/src/font-loader.browser.mjs",
      "default": "./renderer/src/font-loader.node.mjs"
    }
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.4",
    "@fontsource/sarabun": "^5.3.0",
    "astro": "^7.0.2",
    "astro-expressive-code": "^0.44.1",
    "monaco-editor": "0.54.0",
    "opensheetmusicdisplay": "^2.1.2",
    "opentype.js": "^2.0.0",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@xmldom/xmldom": "^0.9.10",
    "eslint": "^10.8.1",
    "globals": "^17.10.0"
  }
}
